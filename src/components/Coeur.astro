---
interface Props { choisie?: boolean; nom: string; }
const { choisie = false, nom } = Astro.props;
---
<button class="coeur" type="button" aria-pressed={choisie ? 'true' : 'false'} aria-label={`Favori : ${nom}`}>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z" /></svg>
</button>
