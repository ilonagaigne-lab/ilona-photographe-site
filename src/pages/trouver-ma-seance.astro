---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { seances, concours } from '../data';
import { photo, cadrage, paragraphe } from '../lib/contenu';
import t from '../contenu/pages/quiz.json';

const prix: Record<string, number> = Object.fromEntries([...seances, ...concours].map((s) => [s.id, s.prix]));
// Une formule retirée des prestations n'a plus de prix : son résultat n'est pas affiché.
const resultats = t.resultats.filter((r) => prix[r.id] != null);
const questions = t.questions;
const conseils = Object.fromEntries(t.resultat.conseils.map((c) => [c.valeur, c.texte]));
---
<Base titre="Trouvez votre séance photo équestre" description="Trois questions, trente secondes : trouvez la séance photo équestre faite pour vous et votre cheval, avec son prix et les soirs de lumière dorée." page="seances">
  <section class="wrap section" style="padding-top: clamp(16px, 3vw, 40px)" data-reveal aria-labelledby="titre">
    <div class="quiz" id="quiz" data-prix={JSON.stringify(prix)} data-conseils={JSON.stringify(conseils)}>
      <div class="quiz-tete">
        <p class="lbl">{t.entete.surtitre}</p>
        <div class="quiz-progression" aria-hidden="true"><span data-barre></span></div>
        <p class="sr" aria-live="polite" data-annonce></p>
      </div>
      <h1 id="titre" class="sr">{t.entete.titre}</h1>

      {questions.map((q, i) => (
        <fieldset class="quiz-etape" data-question={q.cle} hidden={i > 0}>
          <legend class="d quiz-question" tabindex="-1">{q.titre}</legend>
          <p class="quiz-compte">Question {i + 1} sur {questions.length}</p>
          <div class="quiz-choix">
            {q.options.map((o) => (
              <button type="button" class="quiz-option" data-valeur={o.valeur}>
                <span class="quiz-libelle">{o.libelle}</span>
                {o.note && <span class="li" style="font-size: 14px">{o.note}</span>}
              </button>
            ))}
          </div>
          {i > 0 && <button type="button" class="quiz-retour" data-retour>← Question précédente</button>}
        </fieldset>
      ))}

      <div class="quiz-resultat" data-resultat hidden>
        {resultats.map((r) => (
          <article class="resultat" data-formule={r.id} hidden>
            <div class="resultat-photos">
              {r.photos.map((p) => <Image src={photo(p.image)} alt={p.alt ?? ''} widths={[400, 700]} sizes="(max-width: 760px) 50vw, 25vw" style={p.cadrage ? `object-position: ${cadrage(p)}` : undefined} />)}
            </div>
            <div class="stack g16">
              <p class="lbl">{t.resultat.surtitre}</p>
              <h2 class="d resultat-titre" tabindex="-1"><span class="hl">{r.nom}</span></h2>
              <p class="d" style="font-size: 26px; line-height: 1.1">{r.titre}</p>
              <p class="texte" set:html={paragraphe(r.texte)} />
              <p class="prix" style="font-size: 64px; margin: 0; color: var(--rose-profond)">{prix[r.id]} €</p>
            </div>
          </article>
        ))}
        <div class="carte stack g12 conseil">
          <p class="lbl">{t.resultat.titreConseil}</p>
          <p style="margin: 0; font-size: 16px; line-height: 1.6" data-conseil></p>
        </div>
        <div class="stack g12">
          <p class="lbl" style="color: var(--encre)">{t.resultat.titreSoirs}</p>
          <ul class="soirs" data-soirs></ul>
          <p class="li" style="margin: 0; font-size: 14px">{t.resultat.noteSoirs}</p>
        </div>
        <div class="row g12">
          <a class="btn grand" href="/reservation" data-reserver>Réserver cette séance</a>
          <button type="button" class="btn contour" data-recommencer>Refaire le quiz</button>
        </div>
        <p style="margin: 0; font-size: 15px">{t.resultat.hesitation} <a href="/seances">{t.resultat.lienComparer}</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .quiz { max-width: 1100px; display: flex; flex-direction: column; gap: 28px; }
  .quiz-progression { height: 6px; border-radius: 999px; background: rgba(34,34,34,.12); overflow: hidden; margin-top: 14px; }
  .quiz-progression span { display: block; height: 100%; background: var(--rose-profond); transform-origin: 0 50%; transform: scaleX(.05); transition: transform .5s var(--declic); }
  .quiz-etape { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 20px; animation: fondu .5s var(--lumiere) both; }
  .quiz-etape[hidden], .resultat[hidden], .quiz-resultat[hidden] { display: none; }
  .quiz-question { font-size: clamp(44px, 6.4vw, 96px); line-height: 1; padding: 0; outline: none; }
  .quiz-compte { margin: 0; font-size: 14px; }
  .quiz-choix { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px; }
  .quiz-option { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; text-align: left; min-height: 96px; padding: 20px 22px; border-radius: 16px; border: 0; box-shadow: inset 0 0 0 1.5px var(--encre); background: transparent; color: var(--encre); font: 400 15px 'Poppins', sans-serif; cursor: pointer; }
  .quiz-option::before { content: ""; position: absolute; inset: 0; background: var(--rose); z-index: -1; transform: translateY(101%); transition: transform .35s var(--declic); }
  .quiz-option:hover::before, .quiz-option:focus-visible::before { transform: none; }
  .quiz-libelle { font-size: 19px; font-weight: 600; }
  .quiz-retour { align-self: flex-start; border: 0; background: none; padding: 12px 0; font: 500 15px 'Poppins', sans-serif; color: var(--encre); text-decoration: underline; cursor: pointer; }
  .quiz-resultat { display: flex; flex-direction: column; gap: 32px; animation: fondu .6s var(--lumiere) both; }
  .resultat { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
  .resultat-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .resultat-photos :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 4px; }
  .resultat-photos :global(img:nth-child(2)) { margin-top: 48px; }
  .resultat-titre { font-size: clamp(52px, 7vw, 104px); outline: none; }
  .conseil { padding: 24px 28px; max-width: 720px; }
  .soirs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .soirs :global(li) { padding: 16px 18px; border-radius: 16px; background: linear-gradient(135deg, rgba(232,190,60,.35), rgba(231,156,194,.35)); display: flex; flex-direction: column; gap: 4px; }
  .soirs :global(strong) { font-size: 15px; font-weight: 600; }
  .soirs :global(strong)::first-letter { text-transform: uppercase; }
  .soirs :global(span) { font-size: 14px; }
  @media (max-width: 760px) { .resultat { grid-template-columns: 1fr; } }
</style>

<script>
  import { lumiereDuSoir, heure, jour, prochainsSamedis } from '../scripts/soleil.js';
  const quiz = document.getElementById('quiz')!;
  const etapes = [...quiz.querySelectorAll<HTMLElement>('[data-question]')];
  const zoneResultat = quiz.querySelector<HTMLElement>('[data-resultat]')!;
  const barre = quiz.querySelector<HTMLElement>('[data-barre]')!;
  const annonce = quiz.querySelector<HTMLElement>('[data-annonce]')!;
  const reponses: Record<string, string> = {};
  const conseils: Record<string, string> = JSON.parse(quiz.dataset.conseils || '{}');

  function montrer(i: number) {
    etapes.forEach((e, k) => (e.hidden = k !== i));
    zoneResultat.hidden = true;
    barre.style.transform = `scaleX(${Math.max(0.05, i / etapes.length)})`;
    const titre = etapes[i].querySelector<HTMLElement>('legend')!;
    titre.focus({ preventScroll: true });
    annonce.textContent = `Question ${i + 1} sur ${etapes.length} : ${titre.textContent}`;
  }

  function resultat() {
    etapes.forEach((e) => (e.hidden = true));
    zoneResultat.hidden = false;
    barre.style.transform = 'scaleX(1)';
    const fiches = [...zoneResultat.querySelectorAll<HTMLElement>('.resultat')];
    // Réponse sans résultat (formule retirée) : on montre le premier résultat disponible.
    const formule = fiches.some((r) => r.dataset.formule === reponses.envie) ? reponses.envie : fiches[0]?.dataset.formule ?? '';
    fiches.forEach((r) => (r.hidden = r.dataset.formule !== formule));
    quiz.querySelector('[data-conseil]')!.textContent = conseils[reponses.caractere] ?? '';
    const liste = quiz.querySelector('[data-soirs]')!;
    liste.replaceChildren(...prochainsSamedis(3).map((d) => {
      const { doree, coucher } = lumiereDuSoir(d);
      const li = document.createElement('li');
      li.innerHTML = `<strong>${jour(d)}</strong><span>Lumière dorée de ${heure(doree)} à ${heure(coucher)}</span>`;
      return li;
    }));
    quiz.querySelector<HTMLAnchorElement>('[data-reserver]')!.href = `/reservation?formule=${formule}&source=quiz`;
    const titre = zoneResultat.querySelector<HTMLElement>(`.resultat[data-formule="${formule}"] .resultat-titre`);
    titre?.focus({ preventScroll: true });
    annonce.textContent = `Votre séance : ${titre?.textContent ?? ''}`;
    window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }

  quiz.addEventListener('click', (e) => {
    const cible = e.target as HTMLElement;
    const option = cible.closest<HTMLButtonElement>('.quiz-option');
    if (option) {
      const etape = option.closest<HTMLElement>('[data-question]')!;
      reponses[etape.dataset.question!] = option.dataset.valeur!;
      const i = etapes.indexOf(etape);
      return i < etapes.length - 1 ? montrer(i + 1) : resultat();
    }
    if (cible.closest('[data-retour]')) {
      const i = etapes.findIndex((x) => !x.hidden);
      return montrer(Math.max(0, i - 1));
    }
    if (cible.closest('[data-recommencer]')) montrer(0);
  });
</script>
