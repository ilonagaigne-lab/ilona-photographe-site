---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { Image } from 'astro:assets';
import { photo, cadrage, surligne, lignes, paragraphe } from '../../lib/contenu';
import t from '../../contenu/pages/journal-preparer.json';

type Section = { titre: string; texte: string; liste?: string[]; photo?: { image: string; alt?: string; cadrage?: string }; legende?: string; citation?: string };
// Une ligne vide dans le texte = un nouveau paragraphe.
const paragraphes = (texte = '') => texte.split(/\r?\n\s*\r?\n/).filter((x) => x.trim());
// Les sections sont regroupées en blocs de texte, coupés par les citations.
const blocs: { sections: Section[]; citation?: string }[] = [{ sections: [] }];
for (const x of t.sections as Section[]) {
  blocs.at(-1)!.sections.push(x);
  if (x.citation) blocs.push({ sections: [] });
}
blocs.forEach((b) => (b.citation = b.sections.at(-1)?.citation));
const { titre, nomCourt, description } = t.referencement;
---
<Base titre={`${nomCourt || titre} · Journal`} description={description} page="journal" type="article" fil={[{ nom: 'Journal', href: '/journal/preparer-son-cheval' }, { nom: nomCourt || titre, href: '/journal/preparer-son-cheval' }]} schema={[{ '@type': 'Article', headline: titre, description, author: { '@id': 'https://ilonagaigne.com/#ilona' }, publisher: { '@id': 'https://ilonagaigne.com/#activite' }, inLanguage: 'fr-FR' }]}>
  <article>
    <header class="wrap" style="padding-top: clamp(16px, 3vw, 48px)" data-reveal>
      <div class="colonne">
        <p class="lbl">{t.entete.surtitre}</p>
        <h1 class="d" style="font-size: clamp(52px, 7.4vw, 108px); margin-top: 20px" set:html={lignes(t.entete.titre)} />
        <p class="apparait" style="margin: 28px 0 0; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.6" set:html={paragraphe(t.entete.chapo)} />
        <div class="row centre g12 apparait" style="margin-top: 28px; font-size: 14px; --d: .5s">
          <Image src={photo(t.entete.avatar.image)} alt={t.entete.avatar.alt ?? ''} width={88} height={88} style={`width: 44px; height: 44px; border-radius: 50%; object-fit: cover; object-position: ${cadrage(t.entete.avatar, '52% 32%')}`} />
          <span><strong style="font-weight: 600">{t.entete.auteur}</strong> · {t.entete.lecture}</span>
        </div>
      </div>
    </header>

    <div data-reveal style="margin-top: clamp(48px, 6vw, 80px)">
      <Photo src={photo(t.bandeau.image)} alt={t.bandeau.alt ?? ''} ratio="21 / 9" pos={cadrage(t.bandeau, '50% 52%')} prioritaire tailles="100vw" class="bandeau" />
    </div>

    {blocs.map((b) => (
      <>
        {b.sections.length > 0 && (
          <div class="wrap">
            <div class="colonne prose">
              {b.sections.map((x) => (
                <>
                  <h2>{x.titre}</h2>
                  {paragraphes(x.texte).map((p) => <p set:html={paragraphe(p)} />)}
                  {x.liste && x.liste.length > 0 && <ul>{x.liste.map((l) => <li>{l}</li>)}</ul>}
                  {x.photo?.image && (
                    <figure style="margin: 40px 0">
                      <Image src={photo(x.photo.image)} alt={x.photo.alt ?? ''} widths={[600, 1000, 1400]} sizes="(max-width: 760px) 100vw, 720px" style={`width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: ${cadrage(x.photo, '50% 40%')}; border-radius: 4px`} />
                      {x.legende && <figcaption class="li" style="margin-top: 12px; font-size: 15px">{x.legende}</figcaption>}
                    </figure>
                  )}
                </>
              ))}
            </div>
          </div>
        )}
        {b.citation && (
          <div class="wrap" style="padding-block: 24px">
            <blockquote class="d" style="margin: 0 auto; max-width: 1000px; font-size: clamp(36px, 5.4vw, 76px); line-height: 1" set:html={surligne(b.citation).replaceAll('class="hl"', 'class="hl" style="animation: none"')} />
          </div>
        )}
      </>
    ))}

    <div class="wrap" style="padding-top: 40px">
      <section class="carte colonne stack g16" style="padding: clamp(24px, 3vw, 40px)" aria-labelledby="memo">
        <p class="lbl">{t.memo.surtitre}</p>
        <h2 id="memo" class="d" style="font-size: clamp(30px, 3.2vw, 40px)">{t.memo.titre}</h2>
        <ul class="liste li" style="font-size: 18px">{t.memo.points.map((l) => <li>{l}</li>)}</ul>
      </section>
    </div>
  </article>

  <section class="wrap section stack g32" data-reveal aria-labelledby="suite">
    <div class="row entre bas g24">
      <h2 id="suite" class="d h2" set:html={surligne(t.suite.titre)} />
      <a class="btn" href="/reservation">Réserver ma séance</a>
    </div>
    <a class="suite" href="/academie/lire-la-lumiere-du-soir">
      <Photo src={photo(t.suite.photo.image)} alt={t.suite.photo.alt ?? ''} ratio="16 / 10" pos={cadrage(t.suite.photo, '50% 35%')} cache="#EAE2D4" tailles="(max-width: 760px) 100vw, 40vw" curseur={false} />
      <span class="stack g12"><span class="chip contour" style="align-self: flex-start">{t.suite.etiquette}</span><span class="d h3">{t.suite.article}</span><span class="texte" style="font-size: 16px">{t.suite.resume}</span></span>
    </a>
  </section>
</Base>

<style>
  .colonne { max-width: 720px; margin-inline: auto; }
  .prose h2 { font-family: 'Anton', Impact, sans-serif; font-weight: 400; text-transform: uppercase; font-size: clamp(34px, 3.6vw, 44px); line-height: 1; margin: 64px 0 20px; }
  .prose p { margin: 0 0 20px; font-size: clamp(16px, 1.35vw, 19px); line-height: 1.75; }
  .prose ul { margin: 0 0 20px; padding: 0; list-style: none; font-weight: 300; font-style: italic; font-size: clamp(17px, 1.4vw, 20px); line-height: 1.6; }
  .prose li { padding: 8px 0 8px 28px; position: relative; }
  .prose li::before { content: ""; position: absolute; left: 0; top: 21px; width: 14px; height: 6px; background: var(--rose); }
  .suite { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: center; color: var(--encre); text-decoration: none; }
  @media (max-width: 760px) { .suite { grid-template-columns: 1fr; } :global(.bandeau) { aspect-ratio: 4 / 3 !important; } }
</style>
