---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Reel from '../../components/Reel.astro';
import s11 from '../../assets/photos/galoplan-still-11.jpg';
import s21 from '../../assets/photos/galoplan-still-21.jpg';
import s33 from '../../assets/photos/galoplan-still-33.jpg';
import s43 from '../../assets/photos/galoplan-still-43.jpg';
---
<Base titre="Étude de cas GaloPlan" description="Deux réels verticaux tournés à l’écurie pour GaloPlan, l’app du cheval partagé : un film de lancement et un vlog de séance." page="marques">
  <article>
    <section class="wrap" style="padding-top: clamp(24px, 4vw, 56px)" data-reveal aria-labelledby="titre">
      <a class="nl" href="/marques" style="font-size: 14px">← Marques &amp; réseaux</a>
      <p class="lbl" style="margin-top: 24px">Étude de cas · contenu vidéo</p>
      <h1 id="titre" class="d h1 deborde" style="margin-top: 18px">
        <span class="rv"><span>GaloPlan</span></span>
        <span class="rv"><span style="--d: .2s">à <span class="hl" style="--d: .9s">l’écurie</span></span></span>
      </h1>
      <p class="apparait" style="max-width: 760px; margin: 32px 0 0; font-size: clamp(19px, 1.8vw, 26px); line-height: 1.45">Deux réels pour présenter l’app du cheval partagé là où elle sert vraiment : à l’écurie, entre deux séances.</p>
      <dl class="faits apparait" style="--d: .5s">
        <div><dt class="lbl">Client</dt><dd>GaloPlan, application équestre</dd></div>
        <div><dt class="lbl">Mission</dt><dd class="row g8"><span class="chip or">Vidéo</span><span class="chip pervenche">Réseaux</span></dd></div>
        <div><dt class="lbl">Formats</dt><dd>2 réels verticaux, sous-titrés</dd></div>
        <div><dt class="lbl">Durées</dt><dd>46 s et 52 s</dd></div>
      </dl>
    </section>

    <section class="sombre" style="margin-top: clamp(56px, 7vw, 96px)" aria-label="Les deux réels">
      <div class="wrap row" style="padding-block: clamp(56px, 7vw, 88px); justify-content: center; gap: 48px clamp(40px, 6vw, 96px)">
        <figure class="stack g12" style="margin: 0; flex: 0 1 360px">
          <Reel video="galoplan-lancement" titre="GaloPlan, film de lancement" or />
          <figcaption class="row entre" style="align-items: baseline"><span class="d" style="font-size: 30px">Film de lancement</span><span style="font-size: 14px; opacity: .85">46 s</span></figcaption>
        </figure>
        <figure class="stack g12 decale" style="margin: 0; flex: 0 1 360px">
          <Reel video="galoplan-vlog-seance" titre="GaloPlan, vlog de séance" or />
          <figcaption class="row entre" style="align-items: baseline"><span class="d" style="font-size: 30px">Vlog de séance</span><span style="font-size: 14px; opacity: .85">52 s</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="wrap section stack" style="gap: 64px" data-reveal>
      <div class="bloc"><h2 class="d" style="font-size: 48px">Le contexte</h2><p class="texte">GaloPlan réunit tous ceux qui s’occupent d’un même cheval : propriétaires et demi-pensionnaires partagent le planning, les soins et le carnet de l’écurie dans une seule application.</p></div>
      <div class="bloc"><h2 class="d" style="font-size: 48px">Le défi</h2><p class="texte">Faire comprendre une application en moins d’une minute, sans tutoriel figé. Montrer la vraie vie à l’écurie, puis l’app au moment précis où elle rend service.</p></div>
      <div class="bloc"><h2 class="d" style="font-size: 48px">Ce que j’ai fait</h2><ul class="liste li"><li>Tournage à l’écurie, à pied et à cheval</li><li>Coulisses du développement de l’application</li><li>Écrans réels filmés au téléphone, en situation</li><li>Montage vertical sous-titré, aux couleurs de la marque</li></ul></div>
    </section>

    <section class="wrap section sans-haut grille" style="--min: 240px" data-reveal aria-label="Images extraites du vlog">
      <Photo src={s11} alt="Cavalière sur un cheval noir à la selle rose, dans la carrière" cache="#EAE2D4" tailles="(max-width: 760px) 50vw, 25vw" />
      <Photo src={s21} alt="Cavalière au trot sur un cheval gris, entre les obstacles" cache="#EAE2D4" delai=".3s" tailles="(max-width: 760px) 50vw, 25vw" class="decale" />
      <Photo src={s33} alt="Main tenant un téléphone ouvert sur une séance dans l’application GaloPlan" cache="#EAE2D4" delai=".4s" tailles="(max-width: 760px) 50vw, 25vw" />
      <Photo src={s43} alt="Cavalière casquée qui embrasse le chanfrein de son cheval gris" cache="#EAE2D4" delai=".5s" tailles="(max-width: 760px) 50vw, 25vw" class="decale" />
    </section>

    <section class="sombre" data-reveal aria-labelledby="resultats">
      <div class="wrap stack" style="padding-block: clamp(64px, 8vw, 104px); gap: 56px">
        <blockquote style="margin: 0" class="stack g20">
          <p class="d" style="font-size: clamp(36px, 5.4vw, 80px); line-height: 1">« [Citation de l’équipe GaloPlan sur <span class="hl plein">ce qui a changé</span>] »</p>
          <footer style="font-size: 16px">[Prénom Nom], GaloPlan</footer>
        </blockquote>
        <div class="stack g24">
          <h2 id="resultats" class="lbl">Résultats</h2>
          <div class="grille" style="--min: 220px">
            <div class="stat"><p class="prix">[X]</p><p>[vues des deux réels]</p></div>
            <div class="stat"><p class="prix">[X]</p><p>[nouveaux abonnés]</p></div>
            <div class="stat"><p class="prix">[X]</p><p>[inscriptions à l’application]</p></div>
          </div>
        </div>
      </div>
    </section>
  </article>

  <section class="wrap section row entre bas g32" data-reveal aria-labelledby="suite">
    <h2 id="suite" class="d" style="font-size: clamp(52px, 9vw, 140px); line-height: 1">Votre marque,<br>la <span class="hl">prochaine</span> ?</h2>
    <a class="btn grand" href="/marques#contact">Parler de votre projet</a>
  </section>
</Base>

<style>
  .faits { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; margin: 56px 0 0; }
  .faits > div { display: flex; flex-direction: column; gap: 8px; padding-top: 18px; border-top: 1px solid rgba(34,34,34,.25); }
  .faits dd { margin: 0; font-size: 17px; }
  .bloc { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px 24px; align-items: start; }
  .bloc > :first-child { grid-column: 1 / span 4; }
  .bloc > :last-child { grid-column: 6 / span 7; }
  .stat { padding-top: 20px; border-top: 1px solid rgba(236,235,231,.25); }
  .stat .prix { font-size: clamp(60px, 7vw, 96px); margin: 0 0 8px; }
  .stat p:last-child { margin: 0; }
  @media (min-width: 761px) { .decale { margin-top: 64px; } }
  @media (max-width: 760px) {
    .bloc > :first-child, .bloc > :last-child { grid-column: 1 / -1; }
    .bloc h2 { font-size: 34px !important; }
  }
</style>
