---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Reel from '../../components/Reel.astro';
import { galoplan } from '../../data';
import { photo, cadrage, surligne, lignes, paragraphe } from '../../lib/contenu';
import t from '../../contenu/pages/galoplan.json';
const schemaCas = { '@type': 'CreativeWork', name: 'GaloPlan à l’écurie : deux réels verticaux', about: 'Contenu vidéo pour GaloPlan, l’application du cheval partagé', creator: { '@id': 'https://ilonagaigne.com/#ilona' }, inLanguage: 'fr-FR', genre: 'Étude de cas' };
---
<Base titre="Étude de cas GaloPlan" description="Deux réels verticaux tournés à l’écurie pour GaloPlan, l’app du cheval partagé : un film de lancement et un vlog de séance." page="marques" fil={[{ nom: 'Marques & réseaux', href: '/marques' }, { nom: 'Étude de cas GaloPlan', href: '/etudes-de-cas/galoplan' }]} schema={[schemaCas]}>
  <article>
    <section class="wrap" style="padding-top: clamp(24px, 4vw, 56px)" data-reveal aria-labelledby="titre">
      <p class="lbl">{t.entete.surtitre}</p>
      <h1 id="titre" class="d h1 deborde" style="margin-top: 18px" set:html={lignes(t.entete.titre)} />
      <p class="apparait" style="max-width: 760px; margin: 32px 0 0; font-size: clamp(19px, 1.8vw, 26px); line-height: 1.45" set:html={paragraphe(t.entete.chapo)} />
      <dl class="faits apparait" style="--d: .5s">
        <div><dt class="lbl">Client</dt><dd>{t.entete.client}</dd></div>
        <div><dt class="lbl">Mission</dt><dd class="row g8"><span class="chip or">Vidéo</span><span class="chip pervenche">Réseaux</span></dd></div>
        <div><dt class="lbl">Formats</dt><dd>{t.entete.formats}</dd></div>
        <div><dt class="lbl">Durées</dt><dd>{t.entete.durees}</dd></div>
      </dl>
    </section>

    <section class="sombre" style="margin-top: clamp(56px, 7vw, 96px)" aria-label="Les deux réels">
      <div class="wrap row" style="padding-block: clamp(56px, 7vw, 88px); justify-content: center; gap: 48px clamp(40px, 6vw, 96px)">
        <figure class="stack g12" style="margin: 0; flex: 0 1 360px">
          <Reel video={t.reels.lancement.video} or />
          <figcaption class="row entre" style="align-items: baseline"><span class="d" style="font-size: 30px">{t.reels.lancement.legende}</span><span style="font-size: 14px; opacity: .85">{t.reels.lancement.duree}</span></figcaption>
        </figure>
        <figure class="stack g12 decale" style="margin: 0; flex: 0 1 360px">
          <Reel video={t.reels.vlog.video} or />
          <figcaption class="row entre" style="align-items: baseline"><span class="d" style="font-size: 30px">{t.reels.vlog.legende}</span><span style="font-size: 14px; opacity: .85">{t.reels.vlog.duree}</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="wrap section stack" style="gap: 64px" data-reveal>
      {[t.recit.contexte, t.recit.defi].map((r) => <div class="bloc"><h2 class="d" style="font-size: 48px">{r.titre}</h2><p class="texte" set:html={paragraphe(r.texte)} /></div>)}
      <div class="bloc"><h2 class="d" style="font-size: 48px">{t.recit.realisation.titre}</h2><ul class="liste li">{t.recit.realisation.points.map((p) => <li>{p}</li>)}</ul></div>
    </section>

    <section class="wrap section sans-haut grille" style="--min: 240px" data-reveal aria-label="Images extraites du vlog">
      {t.images.map((im, i) => <Photo src={photo(im.image)} alt={im.alt ?? ''} pos={cadrage(im)} cache="#EAE2D4" delai={i ? `${(i + 2) / 10}s` : undefined} tailles="(max-width: 760px) 50vw, 25vw" class={i % 2 ? 'decale' : ''} />)}
    </section>

    {(galoplan.citation || galoplan.resultats.length > 0) && (
      <section class="sombre" data-reveal aria-labelledby="resultats">
        <div class="wrap stack" style="padding-block: clamp(64px, 8vw, 104px); gap: 56px">
          {galoplan.citation && (
            <blockquote style="margin: 0" class="stack g20">
              <p class="d" style="font-size: clamp(36px, 5.4vw, 80px); line-height: 1">« {galoplan.citation} »</p>
              {galoplan.auteur && <footer style="font-size: 16px">{galoplan.auteur}</footer>}
            </blockquote>
          )}
          {galoplan.resultats.length > 0 && (
            <div class="stack g24">
              <h2 id="resultats" class="lbl">Résultats</h2>
              <div class="grille" style="--min: 220px">
                {galoplan.resultats.map((r) => <div class="stat"><p class="prix">{r.valeur}</p><p>{r.libelle}</p></div>)}
              </div>
            </div>
          )}
        </div>
      </section>
    )}
  </article>

  <section class="wrap section row entre bas g32" data-reveal aria-labelledby="suite">
    <h2 id="suite" class="d" style="font-size: clamp(52px, 9vw, 140px); line-height: 1" set:html={surligne(t.fin.titre)} />
    <a class="btn grand" href="/marques#contact">Parler de votre projet</a>
  </section>
</Base>

<style>
  .faits { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; margin: 56px 0 0; }
  .faits > div { display: flex; flex-direction: column; gap: 8px; padding-top: 18px; border-top: 1px solid rgba(34,34,34,.25); }
  .faits dd { margin: 0; font-size: 17px; }
  .bloc { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px 24px; align-items: start; }
  .bloc > :first-child { grid-column: 1 / span 4; }
  .bloc > :last-child { grid-column: 6 / span 7; }
  .stat { padding-top: 20px; border-top: 1px solid rgba(236,235,231,.25); }
  .stat .prix { font-size: clamp(60px, 7vw, 96px); margin: 0 0 8px; }
  .stat p:last-child { margin: 0; }
  @media (min-width: 761px) { .decale { margin-top: 64px; } }
  @media (max-width: 760px) {
    .bloc > :first-child, .bloc > :last-child { grid-column: 1 / -1; }
    .bloc h2 { font-size: 34px !important; }
  }
</style>
