---
import Base from '../layouts/Base.astro';
import Coeur from '../components/Coeur.astro';
import { Image } from 'astro:assets';
import { galerieDemo, commun } from '../data';
import { photo, surligne, paragraphe, gabarit } from '../lib/contenu';
import t from '../contenu/pages/galerie.json';

const photos = t.photos;
const { quota, prixPhoto } = galerieDemo;
// Les {mots} des textes saisis dans le back office sont remplacés ici ; les nombres qui bougent restent dans des balises que le script met à jour.
const [favorisAvant, favorisApres = ''] = t.entete.favoris.split('{n}');
const supplement = paragraphe(t.barre.supplement)
  .replace('{extra}', '<span data-extra>0</span>')
  .replace('{prix}', String(prixPhoto))
  .replace('{total}', '<span class="prix" style="font-size: 32px"><span data-total>0</span>\u00a0€</span>');
const textes = { valider: t.barre.valider, validerEtRegler: t.barre.validerEtRegler, alerteDemo: t.barre.alerteDemo };
---
<Base titre={t.referencement.titre} description={t.referencement.description} page="galerie" indexer={false}>
  <a slot="entete-action" class="nl garde" href="/" style="font-size: 14px">{t.entete.deconnexion}</a>

  <section class="wrap" style="padding-top: 24px; padding-bottom: 48px" data-reveal id="galerie" data-quota={quota} data-prix={prixPhoto} data-textes={JSON.stringify(textes)}>
    <p class="demo">{t.entete.demo}</p>
    <p style="margin: 0 0 32px; font-size: 14px"><strong style="font-weight: 600">{t.entete.galerie}</strong> · {t.entete.seance} · {gabarit(t.entete.nombrePhotos, { n: photos.length })}</p>
    <div class="row entre bas g24" style="margin-bottom: 32px">
      <div class="stack g12">
        <p class="lbl">{t.entete.surtitre}</p>
        <h1 class="d" style="font-size: clamp(52px, 7vw, 104px)" set:html={surligne(t.entete.titre)} />
        <p class="texte" style="max-width: 620px; font-size: 16px">{gabarit(t.entete.consigne, { quota, prix: prixPhoto })}</p>
      </div>
      <div class="row g8" role="group" aria-label={t.entete.filtres}>
        <button class="pastille" type="button" data-filtre="toutes" aria-pressed="true">{gabarit(t.entete.toutes, { n: photos.length })}</button>
        <button class="pastille" type="button" data-filtre="favoris" aria-pressed="false">{favorisAvant}<span data-compte>0</span>{favorisApres}</button>
      </div>
    </div>
    <ul class="grille-photos">
      {photos.map((p, i) => (
        <li class:list={['tuile', { choisie: p.on }]} data-curseur="choisir">
          <Image src={photo(p.image)} alt={p.alt ?? ''} widths={[400, 700]} sizes="(max-width: 760px) 50vw, 25vw" />
          <span class="flash" aria-hidden="true"></span><span class="cadre" aria-hidden="true"></span>
          <span class="num">{gabarit(t.entete.numero, { n: String(i + 1).padStart(2, '0') })}</span>
          <Coeur choisie={p.on} nom={p.alt || gabarit(commun.lecteurs.photoNumero, { n: i + 1 })} />
        </li>
      ))}
    </ul>
    <p data-vide hidden style="margin: 24px 0 0">{t.entete.vide}</p>
  </section>

  <div class="barre sombre" aria-live="polite">
    <div class="wrap row entre centre" style="padding-block: 18px; gap: 14px 40px">
      <div class="stack g8" style="flex: 1 1 320px">
        <p style="margin: 0; font-size: 15px"><span class="prix" style="font-size: 32px"><span data-inclus>0</span> / {quota}</span> {t.barre.inclus}</p>
        <div class="jauge" aria-hidden="true"><span data-jauge style="transform: scaleX(0)"></span></div>
      </div>
      <p data-supplement hidden style="margin: 0; font-size: 15px" set:html={supplement} />
      <button class="btn clair" type="button" data-valider>{t.barre.valider}</button>
    </div>
  </div>
</Base>

<style>
  .demo { display: inline-block; margin: 0 0 20px; padding: 8px 14px; border-radius: 999px; background: var(--pervenche); font-size: 13px; }
  /* Galerie client : photos entières, jamais recadrées (mise en page en colonnes) */
  .grille-photos { list-style: none; margin: 0; padding: 0; columns: 4 230px; column-gap: 14px; }
  .grille-photos .tuile { aspect-ratio: auto; break-inside: avoid; margin: 0 0 14px; }
  .grille-photos .tuile :global(img) { height: auto; object-fit: initial; }
  .grille-photos .tuile[hidden] { display: none; }
  .barre { position: sticky; bottom: 0; z-index: 10; box-shadow: 0 -20px 40px -20px rgba(34,34,34,.4); }
  :global(.pied) { display: none; }
  /* La barre collée en bas ne doit jamais cacher la photo qui reçoit le focus au clavier. */
  :global(html) { scroll-padding-bottom: 140px; }
  @media (max-width: 560px) {
    .grille-photos { columns: 2; column-gap: 8px; } .grille-photos .tuile { margin-bottom: 8px; }
    .barre .wrap { padding-block: 12px !important; gap: 10px 16px !important; }
    .barre .btn { min-height: 44px; }
    :global(html) { scroll-padding-bottom: 180px; }
  }
</style>

<script>
  const zone = document.getElementById('galerie')!;
  const quota = Number(zone.dataset.quota) || 0;
  const prix = Number(zone.dataset.prix) || 0;
  const T = JSON.parse(zone.dataset.textes || '{}');
  const q = (s: string) => document.querySelector(s) as HTMLElement;
  let filtre = 'toutes';
  function maj() {
    const tuiles = [...zone.querySelectorAll<HTMLElement>('.tuile')];
    const n = tuiles.filter((t) => t.classList.contains('choisie')).length;
    const extra = Math.max(0, n - quota);
    q('[data-compte]').textContent = String(n);
    q('[data-inclus]').textContent = String(Math.min(n, quota));
    q('[data-jauge]').style.transform = `scaleX(${quota ? Math.min(n / quota, 1) : (n ? 1 : 0)})`;
    q('[data-supplement]').hidden = extra === 0;
    q('[data-extra]').textContent = String(extra);
    q('[data-total]').textContent = String(extra * prix);
    q('[data-valider]').textContent = extra ? T.validerEtRegler.replace('{total}', String(extra * prix)) : T.valider;
    for (const t of tuiles) t.hidden = filtre === 'favoris' && !t.classList.contains('choisie');
    q('[data-vide]').hidden = !(filtre === 'favoris' && n === 0);
  }
  zone.addEventListener('click', (e) => {
    const cible = e.target as HTMLElement;
    const coeur = cible.closest('.coeur');
    if (coeur) {
      const tuile = coeur.closest('.tuile') as HTMLElement;
      const on = coeur.getAttribute('aria-pressed') !== 'true';
      coeur.setAttribute('aria-pressed', String(on));
      tuile.classList.toggle('choisie', on);
      if (on) { tuile.classList.remove('flashe'); void tuile.offsetWidth; tuile.classList.add('flashe'); }
      maj();
      // Dans « Favoris », une photo retirée disparaît : le focus passe au filtre pour ne pas se perdre.
      if (!on && filtre === 'favoris') zone.querySelector<HTMLElement>('[data-filtre="favoris"]')?.focus();
      return;
    }
    const f = cible.closest<HTMLElement>('[data-filtre]');
    if (f) {
      filtre = f.dataset.filtre!;
      zone.querySelectorAll('[data-filtre]').forEach((b) => b.setAttribute('aria-pressed', String(b === f)));
      maj();
    }
  });
  q('[data-valider]').addEventListener('click', () => {
    alert(T.alerteDemo);
  });
  maj();
</script>
