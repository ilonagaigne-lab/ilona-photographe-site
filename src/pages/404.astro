---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { photo, cadrage, lignes, paragraphe } from '../lib/contenu';
import t from '../contenu/pages/404.json';
---
<Base titre="Page introuvable" description="Cette page est sortie du cadre." indexer={false}>
  <section class="wrap row centre" style="min-height: 70vh; padding-block: 32px 64px; gap: 48px clamp(40px, 6vw, 96px)" data-reveal>
    <div class="stack g24" style="flex: 3 1 480px">
      <p class="lbl">{t.entete.surtitre}</p>
      <h1 class="d" style="font-size: clamp(88px, 16vw, 240px)" set:html={lignes(t.entete.titre)} />
      <p class="texte" style="max-width: 480px" set:html={paragraphe(t.entete.texte)} />
      <div class="row g12">
        <a class="btn" href="/">Revenir à l’accueil</a>
        <a class="btn contour" href="/seances">Voir les séances</a>
      </div>
    </div>
    <div class="hors-champ" aria-hidden="true">
      <Image src={photo(t.photo.image)} alt={t.photo.alt ?? ''} style={`object-position: ${cadrage(t.photo)}`} widths={[400, 700]} sizes="(max-width: 760px) 100vw, 35vw" />
    </div>
  </section>
</Base>

<style>
  .hors-champ { flex: 2 1 300px; aspect-ratio: 4 / 5; max-height: 600px; overflow: hidden; border-radius: 4px; }
  .hors-champ :global(img) { width: 100%; height: 100%; object-fit: cover; transform: translateX(42%); animation: glisse 1.4s var(--lumiere) both .3s; }
  @keyframes glisse { from { transform: translateX(0); } }
</style>
