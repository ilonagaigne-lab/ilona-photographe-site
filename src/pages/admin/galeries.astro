---
// Page d'Ilona pour créer et gérer les projets (galeries privées) de ses clients (hors Decap).
// Connexion : celle du back office (jeton GitHub gardé par Decap). Photos : envoyées directement au magasin Blob.
import { seances, concours, galerieDemo } from '../../data';

const formules = [
  ...seances.map((s) => `Séance ${s.nom}`),
  ...concours.map((c) => c.nom),
];
const reglages = JSON.stringify({ quota: galerieDemo.quota, prixPhoto: galerieDemo.prixPhoto });
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Projets clients · Ilona Photographe</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body data-reglages={reglages}>
  <header class="gal-haut">
    <a class="gal-retour" href="/admin">← Retour au back office</a>
    <p class="gal-marque">Ilona</p>
  </header>

  <main class="gal-page" id="app">
    <p class="gal-info" id="chargement">Chargement…</p>

    <section id="vue-connexion" hidden>
      <h1>Projets clients</h1>
      <div class="gal-carte gal-centre">
        <p id="texte-connexion">Connectez-vous d’abord au back office, puis revenez sur cette page.</p>
        <a class="gal-bouton" href="/admin">Aller au back office</a>
      </div>
    </section>

    <section id="vue-liste" hidden>
      <div class="gal-entete">
        <div>
          <p class="gal-sur">Vos clients</p>
          <h1>Projets clients</h1>
          <p class="gal-intro">Un projet par client : c’est un dossier qui réunit ses photos. Vous envoyez les photos, vous copiez le lien, et votre client les retrouve sur son téléphone ou son ordinateur.</p>
        </div>
        <button type="button" class="gal-bouton" id="nouvelle">Nouveau projet</button>
      </div>
      <p class="gal-erreur" id="erreur-liste" role="alert" hidden></p>
      <ul class="gal-liste" id="liste"></ul>
      <p class="gal-info" id="liste-vide" hidden>Aucun projet pour l’instant. Cliquez sur « Nouveau projet » pour commencer.</p>
    </section>

    <section id="vue-editeur" hidden>
      <button type="button" class="gal-lien" id="retour-liste">← Tous les projets</button>
      <h1 id="titre-editeur">Nouveau projet</h1>

      <form id="formulaire" class="gal-carte" novalidate>
        <h2>1. Informations</h2>
        <div class="gal-champ">
          <label for="f-titre">Nom du projet</label>
          <input id="f-titre" name="titre" type="text" maxlength="120" required autocomplete="off">
          <p class="gal-aide">Votre client le voit en haut de sa galerie. Vous pouvez le changer quand vous voulez. Ex. : Léa et Caramel</p>
        </div>
        <div class="gal-champ">
          <label for="f-seance">Séance</label>
          <input id="f-seance" name="seance" type="text" maxlength="120" list="formules" autocomplete="off">
          <datalist id="formules">
            {formules.map((f) => <option value={f} />)}
          </datalist>
          <p class="gal-aide">Choisissez une formule dans la liste, ou écrivez ce que vous voulez. Ex. : Séance Signature</p>
        </div>
        <div class="gal-champ">
          <label for="f-date">Date de la séance</label>
          <input id="f-date" name="date" type="date">
          <p class="gal-aide">Facultative. Si vous la laissez vide, elle se remplit toute seule avec la date de prise de vue de la photo la plus ancienne. Ex. : 14 novembre 2026</p>
        </div>

        <fieldset class="gal-champ">
          <legend>Que fait votre client avec ses photos ?</legend>
          <div class="gal-modes">
            <label class="gal-mode">
              <input type="radio" name="mode" value="telechargement" checked>
              <span><strong>Il télécharge ses photos</strong>Il regarde ses photos en grand, puis les télécharge une par une ou toutes d’un coup.</span>
            </label>
            <label class="gal-mode">
              <input type="radio" name="mode" value="selection">
              <span><strong>Il choisit ses favoris</strong>Il marque ses photos préférées et sa liste vous arrive par e-mail.</span>
            </label>
          </div>
        </fieldset>

        <div class="gal-deux" id="bloc-selection" hidden>
          <div class="gal-champ">
            <label for="f-quota">Photos incluses dans la formule</label>
            <input id="f-quota" name="quota" type="number" min="0" max="1000" step="1" inputmode="numeric">
            <p class="gal-aide">Au-delà, chaque photo choisie est comptée en plus. Ex. : 8</p>
          </div>
          <div class="gal-champ">
            <label for="f-prix">Prix d’une photo en plus (€)</label>
            <input id="f-prix" name="prixPhoto" type="number" min="0" max="10000" step="1" inputmode="numeric">
            <p class="gal-aide">Ces deux valeurs viennent de « Formules et coordonnées ». Changez-les ici seulement pour ce projet. Ex. : 10</p>
          </div>
        </div>

        <div class="gal-champ">
          <label for="f-expire">Disponible jusqu’au</label>
          <input id="f-expire" name="expireLe" type="date" required>
          <p class="gal-aide">Après cette date, le projet et ses photos disparaissent tous seuls. Par défaut : 3 mois. Ex. : 14 février 2027</p>
        </div>

        <p class="gal-erreur" id="erreur-formulaire" role="alert" hidden></p>
        <div class="gal-actions">
          <button type="submit" class="gal-bouton" id="enregistrer">Créer le projet</button>
        </div>
      </form>

      <section id="bloc-photos" class="gal-carte" hidden>
        <h2>2. Contenu du projet</h2>
        <div class="gal-depot" id="depot">
          <p><strong>Glissez vos photos ici</strong>, ou</p>
          <label class="gal-bouton gal-bouton-clair" for="f-fichiers">Choisir des photos</label>
          <input id="f-fichiers" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" multiple class="gal-cache">
          <p class="gal-aide">Photos en JPG de préférence, 60 Mo au maximum chacune. Vous pouvez en envoyer plusieurs centaines : elles partent trois par trois. Votre client téléchargera les fichiers tels que vous les envoyez.</p>
        </div>

        <div id="envoi" hidden>
          <progress id="progression" max="1" value="0" aria-labelledby="progression-texte"></progress>
          <p id="progression-texte" class="gal-info" role="status"></p>
          <div id="echecs" class="gal-erreur" role="alert" hidden>
            <p id="echecs-texte"></p>
            <ul id="echecs-liste"></ul>
            <button type="button" class="gal-bouton gal-bouton-clair" id="reessayer">Réessayer</button>
          </div>
        </div>

        <fieldset class="gal-champ gal-ordre">
          <legend>Ordre des photos</legend>
          <div class="gal-modes">
            <label class="gal-mode">
              <input type="radio" name="tri" value="date" checked>
              <span><strong>Par date de prise de vue</strong>Dans l’ordre où elles ont été prises. Celles sans date passent à la fin.</span>
            </label>
            <label class="gal-mode">
              <input type="radio" name="tri" value="nom">
              <span><strong>Par nom de fichier</strong>Dans l’ordre des noms. Ex. : IMG_2 avant IMG_10</span>
            </label>
          </div>
          <p class="gal-aide">Votre client voit ses photos dans cet ordre. Le changement est enregistré tout de suite.</p>
        </fieldset>

        <div class="gal-barre-photos">
          <p id="compte-photos" class="gal-info" tabindex="-1"></p>
          <div class="gal-actions">
            <button type="button" class="gal-bouton gal-bouton-clair" id="tout-cocher">Tout sélectionner</button>
            <button type="button" class="gal-bouton gal-bouton-danger" id="retirer-selection" disabled>Retirer la sélection</button>
            <button type="button" class="gal-bouton" id="sauver-photos" hidden>Enregistrer les photos</button>
          </div>
        </div>
        <p class="gal-info gal-statut" id="statut-photos" role="status"></p>
        <ul class="gal-photos" id="photos"></ul>
      </section>

      <section id="bloc-lien" class="gal-carte" hidden>
        <h2>3. Lien à envoyer au client</h2>
        <p class="gal-aide">Envoyez ce lien par message ou par e-mail. Il est impossible à deviner : seules les personnes qui le reçoivent voient les photos.</p>
        <div class="gal-lien-ligne">
          <input id="lien" type="text" readonly aria-label="Lien du projet à envoyer au client">
          <button type="button" class="gal-bouton" id="copier">Copier le lien</button>
          <a class="gal-bouton gal-bouton-clair" id="voir" href="/" target="_blank" rel="noopener">Voir comme le client</a>
        </div>
        <p class="gal-info" id="copie-ok" role="status"></p>
      </section>

      <section id="bloc-reception" class="gal-carte" hidden>
        <h2>Sélection reçue</h2>
        <p class="gal-info" id="reception-date"></p>
        <p id="reception-message" class="gal-citation" hidden></p>
        <ol id="reception-liste" class="gal-numeros"></ol>
        <button type="button" class="gal-bouton gal-bouton-clair" id="copier-selection">Copier la liste des fichiers</button>
      </section>
    </section>
  </main>

  <div class="gal-toast" id="toast" role="status"></div>
</body>
</html>

<script>
  import { uploadPresigned as upload } from '@vercel/blob/client';
  import { lirePrise, formaterPrise, trierPhotos } from '../../scripts/projets-photos.js';

  const $ = (id) => document.getElementById(id);
  const NBSP = ' ';
  const reglages = JSON.parse(document.body.dataset.reglages || '{}');
  let galerie = null; // galerie ouverte (avec son id une fois créée)
  let photos = []; // photos enregistrées ou en attente d'enregistrement, dans l'ordre choisi
  let tri = 'date'; // ordre choisi : « date » (prise de vue) ou « nom »
  const cochees = new Set(); // photos cochées (adresse de l'original) pour un retrait groupé
  let sale = false; // des changements de photos ne sont pas encore enregistrés
  let enCours = 0; // photos en cours d'envoi
  let echecs = []; // fichiers à renvoyer
  let occupe = false; // un lot de photos est en cours d'envoi
  let enregistre = false; // un enregistrement des photos est en cours
  const bloque = () => occupe || enregistre;

  // ---------- Connexion : le jeton que Decap garde après la connexion GitHub ----------
  function jeton() {
    try { return JSON.parse(localStorage.getItem('decap-cms-user') || localStorage.getItem('netlify-cms-user') || 'null')?.token || ''; } catch { return ''; }
  }
  const enTete = () => ({ Authorization: `Bearer ${jeton()}` });

  class Deconnecte extends Error {}
  async function appel(url, options = {}) {
    let r;
    try {
      r = await fetch(url, { ...options, headers: { ...enTete(), ...(options.body ? { 'Content-Type': 'application/json' } : {}) } });
    } catch {
      throw new Error('Impossible de joindre le site. Vérifiez votre connexion, puis réessayez.');
    }
    if (r.status === 401) throw new Deconnecte();
    const donnees = await r.json().catch(() => ({}));
    if (!r.ok || donnees.ok === false) throw new Error(donnees.erreur || 'Une erreur est survenue. Réessayez dans un instant.');
    return donnees;
  }

  // ---------- Affichage ----------
  const vues = ['vue-connexion', 'vue-liste', 'vue-editeur'];
  function montrer(nom) {
    $('chargement').hidden = true;
    for (const v of vues) $(v).hidden = v !== nom;
    window.scrollTo(0, 0);
  }
  function deconnecte(message) {
    if (message) $('texte-connexion').textContent = message;
    montrer('vue-connexion');
  }
  // Message lié aux photos : dans le flux de la page (sous la barre d'actions), jamais par-dessus une photo.
  function statut(texte) {
    const s = $('statut-photos');
    s.textContent = texte;
    clearTimeout(statut.minuteur);
    statut.minuteur = setTimeout(() => { s.textContent = ''; }, 6000);
  }
  function toast(texte) {
    const t = $('toast');
    t.textContent = texte;
    t.classList.add('visible');
    clearTimeout(toast.minuteur);
    toast.minuteur = setTimeout(() => t.classList.remove('visible'), 3500);
  }
  function erreur(id, texte) {
    const e = $(id);
    e.textContent = texte || '';
    e.hidden = !texte;
  }
  const poids = (o) => (o >= 1e9 ? `${(o / 1e9).toFixed(1).replace('.', ',')}${NBSP}Go` : `${Math.max(1, Math.round(o / 1e6))}${NBSP}Mo`);
  // « 1er février 2026 » (ou « 1er févr. 2026 » en court) : le premier du mois s'écrit « 1er »
  const jour = (iso, mois = 'long') => {
    if (!iso) return '';
    const d = new Date(`${iso.slice(0, 10)}T12:00:00`);
    if (Number.isNaN(d.getTime())) return '';
    const reste = d.toLocaleDateString('fr-FR', { day: 'numeric', month: mois, year: 'numeric' });
    return d.getDate() === 1 ? reste.replace(/^1(?=\s)/, '1er') : reste;
  };
  const lienVoir = (g) => (/^(localhost|127\.|\[::1\])/.test(location.hostname) ? `/galerie-privee?id=${g.id}` : `/photos/${g.id}`);
  const pluriel = (n, un, plusieurs) => `${n}${NBSP}${n > 1 ? plusieurs : un}`;

  async function copier(texte) {
    try {
      await navigator.clipboard.writeText(texte);
      return true;
    } catch {
      const t = document.createElement('textarea');
      t.value = texte;
      document.body.append(t);
      t.select();
      const ok = document.execCommand('copy');
      t.remove();
      return ok;
    }
  }

  // ---------- Liste ----------
  async function afficherListe() {
    if (!jeton()) return deconnecte();
    montrer('vue-liste');
    erreur('erreur-liste', '');
    const ul = $('liste');
    ul.replaceChildren();
    $('liste-vide').hidden = true;
    let donnees;
    try {
      donnees = await appel('/api/galeries');
    } catch (e) {
      if (e instanceof Deconnecte) return deconnecte('Votre connexion au back office a expiré. Reconnectez-vous, puis revenez sur cette page.');
      return erreur('erreur-liste', e.message);
    }
    $('liste-vide').hidden = donnees.galeries.length > 0;
    for (const g of donnees.galeries) ul.append(carteGalerie(g));
  }

  function carteGalerie(g) {
    const li = document.createElement('li');
    li.className = 'gal-carte gal-ligne gal-dossier';
    const vignette = document.createElement('div');
    vignette.className = 'gal-vignette';
    if (g.vignette) {
      const img = document.createElement('img');
      img.src = g.vignette;
      img.alt = '';
      img.width = 120;
      img.height = 90;
      img.loading = 'lazy';
      img.decoding = 'async';
      vignette.append(img);
    } else {
      vignette.classList.add('vide');
      vignette.textContent = 'Aucune photo';
    }
    const infos = document.createElement('div');
    infos.className = 'gal-dossier-infos';
    const quand = document.createElement('p');
    quand.className = 'gal-quand';
    quand.textContent = jour(g.dateProjet || g.date || g.creeLe, 'short');
    const titre = document.createElement('h2');
    titre.textContent = g.titre;
    const meta = document.createElement('p');
    meta.className = 'gal-aide';
    meta.textContent = g.seance || 'Séance non précisée';
    const etat = document.createElement('p');
    etat.className = 'gal-pastilles';
    const pastille = (t, classe = '') => { const s = document.createElement('span'); s.className = `gal-pastille ${classe}`; s.textContent = t; etat.append(s); };
    pastille(g.mode === 'selection' ? 'Sélection' : 'Téléchargement');
    pastille(`${pluriel(g.nbPhotos, 'photo', 'photos')} · ${poids(g.poids)}`);
    pastille(g.tri === 'nom' ? 'Par nom de fichier' : 'Par date de prise de vue');
    pastille(g.expiree ? `Expirée le ${jour(g.expireLe)}` : `Expire le ${jour(g.expireLe)}`, g.expiree ? 'alerte' : '');
    if (g.selectionRecue) pastille('Sélection reçue', 'bonne');
    infos.append(quand, titre, meta, etat);

    const actions = document.createElement('div');
    actions.className = 'gal-actions';
    const bouton = (texte, fn, classe = 'gal-bouton-clair') => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = `gal-bouton ${classe}`;
      b.textContent = texte;
      b.addEventListener('click', () => fn(b));
      actions.append(b);
      return b;
    };
    bouton('Ouvrir', () => ouvrir(g.id), '').setAttribute('aria-label', `Ouvrir le projet ${g.titre}`);
    bouton('Copier le lien', async () => toast((await copier(g.lien)) ? 'Lien copié.' : 'Copie impossible : ouvrez le projet pour copier le lien à la main.'));
    const voir = document.createElement('a');
    voir.className = 'gal-bouton gal-bouton-clair';
    voir.href = lienVoir(g);
    voir.target = '_blank';
    voir.rel = 'noopener';
    voir.textContent = 'Voir comme le client';
    actions.append(voir);
    bouton('Supprimer', async () => {
      if (!confirm(`Supprimer le projet « ${g.titre} » et toutes ses photos ?${'\n\n'}Cette action est définitive : le lien ne fonctionnera plus.`)) return;
      try {
        await appel(`/api/galeries?id=${g.id}`, { method: 'DELETE' });
        toast('Projet supprimé.');
        afficherListe();
      } catch (e) {
        if (e instanceof Deconnecte) return deconnecte('Votre connexion au back office a expiré. Reconnectez-vous, puis revenez sur cette page.');
        erreur('erreur-liste', e.message);
      }
    }, 'gal-bouton-danger');
    li.append(vignette, infos, actions);
    return li;
  }

  // ---------- Éditeur ----------
  const formulaire = $('formulaire');
  const mode = () => formulaire.elements.mode.value;
  function majMode() { $('bloc-selection').hidden = mode() !== 'selection'; }
  formulaire.addEventListener('change', (e) => { if (e.target.name === 'mode') majMode(); });

  function dansTroisMois() {
    const d = new Date();
    d.setMonth(d.getMonth() + 3);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  function remplir(g) {
    galerie = g;
    tri = g?.tri === 'nom' ? 'nom' : 'date';
    photos = trierPhotos(g?.photos, tri);
    cochees.clear();
    sale = false;
    enCours = 0;
    echecs = [];
    const f = formulaire.elements;
    f.titre.value = g?.titre || '';
    f.seance.value = g?.seance || '';
    f.date.value = g?.date || '';
    f.mode.value = g?.mode || 'telechargement';
    f.quota.value = g?.quota ?? reglages.quota ?? 8;
    f.prixPhoto.value = g?.prixPhoto ?? reglages.prixPhoto ?? 10;
    f.expireLe.value = g?.expireLe || dansTroisMois();
    majMode();
    erreur('erreur-formulaire', '');
    $('titre-editeur').textContent = g ? g.titre : 'Nouveau projet';
    for (const r of document.querySelectorAll('input[name="tri"]')) r.checked = r.value === tri;
    $('enregistrer').textContent = g ? 'Enregistrer les informations' : 'Créer le projet';
    $('bloc-photos').hidden = !g;
    $('bloc-lien').hidden = !g;
    $('envoi').hidden = true;
    $('echecs').hidden = true;
    if (g) {
      $('lien').value = `${location.origin.startsWith('http://localhost') ? location.origin : 'https://ilonagaigne.com'}/photos/${g.id}`;
      $('voir').href = lienVoir(g);
      $('copie-ok').textContent = '';
      dessinerPhotos();
    }
    reception(g);
    montrer('vue-editeur');
  }

  async function ouvrir(id) {
    try {
      const r = await appel(`/api/galeries?id=${id}`);
      remplir(r.galerie);
      $('lien').value = r.lien;
    } catch (e) {
      if (e instanceof Deconnecte) return deconnecte('Votre connexion au back office a expiré. Reconnectez-vous, puis revenez sur cette page.');
      toast(e.message);
    }
  }

  function champsFormulaire() {
    const f = formulaire.elements;
    return {
      titre: f.titre.value.trim(), seance: f.seance.value.trim(), date: f.date.value, mode: mode(),
      quota: Number(f.quota.value), prixPhoto: Number(f.prixPhoto.value), expireLe: f.expireLe.value,
    };
  }

  formulaire.addEventListener('submit', async (e) => {
    e.preventDefault();
    erreur('erreur-formulaire', '');
    const champs = champsFormulaire();
    if (!champs.titre) return erreur('erreur-formulaire', 'Donnez un nom au projet. Ex. : Léa et Caramel');
    if (!champs.expireLe) return erreur('erreur-formulaire', 'Indiquez la date jusqu’à laquelle le projet reste disponible.');
    if (!Number.isInteger(champs.quota) || !Number.isInteger(champs.prixPhoto)) return erreur('erreur-formulaire', 'Le nombre de photos incluses et le prix d’une photo doivent être des nombres entiers.');
    const bouton = $('enregistrer');
    bouton.disabled = true;
    try {
      const corps = galerie ? { ...champs, id: galerie.id } : champs;
      const r = await appel('/api/galeries', { method: 'POST', body: JSON.stringify(corps) });
      const premiere = !galerie;
      remplir({ ...r.galerie, photos: premiere ? [] : photos });
      $('lien').value = r.lien;
      toast(premiere ? 'Projet créé. Ajoutez maintenant vos photos.' : 'Informations enregistrées.');
      if (premiere) $('bloc-photos').scrollIntoView({ behavior: 'smooth' });
    } catch (err) {
      if (err instanceof Deconnecte) return deconnecte('Votre connexion au back office a expiré. Reconnectez-vous, puis revenez sur cette page.');
      erreur('erreur-formulaire', err.message);
    } finally {
      bouton.disabled = false;
    }
  });

  // ---------- Lien ----------
  $('copier').addEventListener('click', async () => {
    $('copie-ok').textContent = (await copier($('lien').value)) ? 'Lien copié. Collez-le dans votre message.' : 'Copie impossible : sélectionnez le lien et copiez-le à la main.';
  });

  // ---------- Sélection reçue ----------
  function reception(g) {
    const s = g?.selection;
    $('bloc-reception').hidden = !s;
    if (!s) return;
    $('reception-date').textContent = `Reçue le ${jour(s.envoyeeLe)}. ${pluriel(s.photos.length, 'photo choisie', 'photos choisies')}, dont ${Math.max(0, s.photos.length - (g.quota || 0))} en supplément.`;
    const m = $('reception-message');
    m.hidden = !s.message;
    m.textContent = s.message ? `« ${s.message} »` : '';
    const ol = $('reception-liste');
    ol.replaceChildren();
    const vues = trierPhotos(g.photos, g.tri); // l'ordre que le client voyait
    const noms = [];
    for (const n of [...s.photos].sort((a, b) => a - b)) {
      const p = vues[n];
      if (!p) continue;
      noms.push(p.nom);
      const li = document.createElement('li');
      li.textContent = `N°${NBSP}${String(n + 1).padStart(2, '0')} · ${p.nom}`;
      ol.append(li);
    }
    $('copier-selection').onclick = async () => toast((await copier(noms.join('\n'))) ? 'Liste copiée.' : 'Copie impossible.');
  }

  // ---------- Contenu du projet : grille des photos ----------
  const cases = new Map(); // case à cocher de chaque photo (adresse de l'original)
  const boutonsRetirer = new Map(); // bouton « Retirer » de chaque photo (pour y remettre le focus)
  function dessinerPhotos() {
    const ul = $('photos');
    ul.replaceChildren();
    cases.clear();
    boutonsRetirer.clear();
    const presentes = new Set(photos.map((p) => p.original));
    for (const k of [...cochees]) if (!presentes.has(k)) cochees.delete(k);
    photos.forEach((p, i) => {
      const li = document.createElement('li');
      li.className = 'gal-photo';
      const img = document.createElement('img');
      img.src = p.miniature;
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';
      if (p.largeur && p.hauteur) { img.width = p.largeur; img.height = p.hauteur; }
      const nom = document.createElement('p');
      nom.className = 'gal-nom';
      nom.textContent = `${String(i + 1).padStart(2, '0')} · ${p.nom}`;
      const date = document.createElement('p');
      date.className = 'gal-prise';
      date.textContent = formaterPrise(p.prise);
      const barre = document.createElement('div');
      barre.className = 'gal-mini-actions';
      const coche = document.createElement('label');
      coche.className = 'gal-coche';
      const case_ = document.createElement('input');
      case_.type = 'checkbox';
      case_.checked = cochees.has(p.original);
      cases.set(p.original, case_);
      case_.disabled = occupe;
      case_.setAttribute('aria-label', `Choisir la photo ${p.nom}`);
      case_.addEventListener('change', () => {
        if (case_.checked) cochees.add(p.original); else cochees.delete(p.original);
        majSelection();
      });
      coche.append(case_, document.createTextNode(' Choisir'));
      const retirer = document.createElement('button');
      retirer.type = 'button';
      retirer.textContent = 'Retirer';
      retirer.disabled = bloque();
      boutonsRetirer.set(p.original, retirer);
      retirer.setAttribute('aria-label', `Retirer la photo ${p.nom}`);
      retirer.addEventListener('click', () => retirerPhotos([p], `la photo «${NBSP}${p.nom}${NBSP}»`));
      barre.append(coche, retirer);
      li.append(img, nom, date, barre);
      ul.append(li);
    });
    $('compte-photos').textContent = photos.length ? `${pluriel(photos.length, 'photo', 'photos')} · ${poids(photos.reduce((t, p) => t + (p.poids || 0), 0))}` : 'Aucune photo pour l’instant.';
    $('sauver-photos').hidden = !sale || occupe; // visible seulement si un enregistrement a échoué
    $('f-fichiers').disabled = bloque();
    $('enregistrer').disabled = bloque();
    $('depot').classList.toggle('occupe', bloque());
    for (const r of document.querySelectorAll('input[name="tri"]')) { r.checked = r.value === tri; r.disabled = bloque(); }
    majSelection();
  }
  function majSelection() {
    const n = cochees.size;
    const retirer = $('retirer-selection');
    retirer.textContent = n ? `Retirer la sélection (${n})` : 'Retirer la sélection';
    retirer.disabled = !n || bloque();
    const tout = $('tout-cocher');
    tout.textContent = photos.length && n === photos.length ? 'Tout désélectionner' : 'Tout sélectionner';
    tout.disabled = !photos.length || occupe;
    for (const [adresse, c] of cases) c.checked = cochees.has(adresse);
  }
  function changer() { sale = true; dessinerPhotos(); }

  $('tout-cocher').addEventListener('click', () => {
    if (cochees.size === photos.length) cochees.clear(); else for (const p of photos) cochees.add(p.original);
    majSelection();
  });

  // Retirer une ou plusieurs photos : confirmation, puis enregistrement tout de suite (les fichiers sont supprimés).
  async function retirerPhotos(aRetirer, quoi) {
    if (bloque() || !aRetirer.length) return;
    const n = aRetirer.length;
    const place = Math.min(...aRetirer.map((p) => photos.indexOf(p)));
    if (!confirm(`Retirer ${quoi} du projet ?${'\n\n'}${n > 1 ? 'Elles seront supprimées' : 'Elle sera supprimée'} définitivement, y compris chez votre client.`)) return;
    const adresses = new Set(aRetirer.map((p) => p.original));
    photos = photos.filter((p) => !adresses.has(p.original));
    for (const a of adresses) cochees.delete(a);
    changer();
    if (await sauverPhotos(true)) statut(n > 1 ? `${n} photos retirées.` : 'Photo retirée.');
    // Le focus ne doit pas tomber sur la page : photo suivante, sinon précédente, sinon le compteur.
    const suivante = photos[Math.min(place, photos.length - 1)];
    (suivante && boutonsRetirer.get(suivante.original) || $('compte-photos')).focus();
  }
  $('retirer-selection').addEventListener('click', () => {
    const choisies = photos.filter((p) => cochees.has(p.original));
    retirerPhotos(choisies, choisies.length > 1 ? `ces ${choisies.length}${NBSP}photos` : 'cette photo');
  });

  // Ordre des photos : la grille change aussitôt, puis le choix est enregistré.
  for (const r of document.querySelectorAll('input[name="tri"]')) {
    r.addEventListener('change', async () => {
      if (bloque()) return dessinerPhotos();
      tri = r.value;
      photos = trierPhotos(photos, tri);
      changer();
      const ok = await sauverPhotos(true);
      if (ok) statut('Ordre enregistré.');
      r.focus();
    });
  }

  // Les informations déjà enregistrées du projet : un enregistrement de photos n'embarque pas une modification de nom non validée.
  const champsEnregistres = () => ({
    titre: galerie.titre, seance: galerie.seance || '', date: galerie.date || '', mode: galerie.mode,
    quota: galerie.quota, prixPhoto: galerie.prixPhoto, expireLe: galerie.expireLe,
  });

  async function sauverPhotos(silencieux) {
    if (!galerie) return false;
    enregistre = true;
    dessinerPhotos();
    try {
      const r = await appel('/api/galeries', { method: 'POST', body: JSON.stringify({ ...champsEnregistres(), id: galerie.id, tri, photos }) });
      galerie = r.galerie;
      tri = r.galerie.tri === 'nom' ? 'nom' : 'date';
      photos = trierPhotos(r.galerie.photos, tri);
      sale = false;
      enregistre = false;
      dessinerPhotos();
      if (!silencieux) statut('Photos enregistrées.');
      return true;
    } catch (err) {
      enregistre = false;
      dessinerPhotos();
      if (err instanceof Deconnecte) { deconnecte('Votre connexion au back office a expiré. Reconnectez-vous, puis revenez sur cette page.'); return false; }
      statut(err.message);
      return false;
    }
  }
  $('sauver-photos').addEventListener('click', () => sauverPhotos(false));

  // ---------- Photos : fabrication des versions réduites dans le navigateur ----------
  function reduire(bitmap, cote, qualite) {
    const echelle = Math.min(1, cote / Math.max(bitmap.width, bitmap.height));
    const l = Math.max(1, Math.round(bitmap.width * echelle));
    const h = Math.max(1, Math.round(bitmap.height * echelle));
    const toile = document.createElement('canvas');
    toile.width = l;
    toile.height = h;
    const ctx = toile.getContext('2d');
    ctx.imageSmoothingQuality = 'high';
    ctx.fillStyle = '#fff'; // fond des PNG transparents
    ctx.fillRect(0, 0, l, h);
    ctx.drawImage(bitmap, 0, 0, l, h);
    return new Promise((ok, ko) => toile.toBlob((b) => (b ? ok(b) : ko(new Error('Aperçu impossible à préparer.'))), 'image/jpeg', qualite));
  }

  const alea = () => { const o = new Uint8Array(9); crypto.getRandomValues(o); return btoa(String.fromCharCode(...o)).replace(/\+/g, '-').replace(/\//g, '_'); };
  // Nom propre, identique pour la photo seule et dans le zip : extension gardée, pas de « .. », 120 caractères au plus.
  const nomSur = (n) => {
    const propre = n.normalize('NFC').replace(/[^\p{L}\p{N}._-]+/gu, '-').replace(/\.{2,}/g, '.').replace(/^[-.]+|[-.]+$/g, '');
    const ext = (propre.match(/\.[\p{L}\p{N}]{1,5}$/u) || [''])[0];
    return (propre.slice(0, propre.length - ext.length).slice(0, 120 - ext.length) || 'photo') + ext;
  };

  async function envoyerPhoto(fichier) {
    const id = galerie.id;
    const base = nomSur(fichier.name);
    const sansExt = base.replace(/\.[^.]*$/, '') || 'photo';
    const prise = await lirePrise(fichier); // date de prise de vue, lue dans le début du fichier
    let bitmap;
    try {
      bitmap = await createImageBitmap(fichier);
    } catch {
      throw new Error('format non lisible par ce navigateur (essayez en JPG)');
    }
    const options = {
      access: 'public',
      handleUploadUrl: '/api/galeries-envoi',
      headers: enTete(),
      clientPayload: JSON.stringify({ expireLe: formulaire.elements.expireLe.value }),
      multipart: fichier.size > 30e6,
    };
    try {
      const vue = await reduire(bitmap, 2048, 0.85);
      const miniature = await reduire(bitmap, 800, 0.8);
      let o, v, m;
      try {
        [o, v, m] = await Promise.all([
        upload(`galeries/${id}/originaux/${alea()}/${base}`, fichier, { ...options, contentType: fichier.type || 'image/jpeg' }),
        upload(`galeries/${id}/vues/${alea()}/${sansExt}.jpg`, vue, { ...options, contentType: 'image/jpeg', multipart: false }),
        upload(`galeries/${id}/miniatures/${alea()}/${sansExt}.jpg`, miniature, { ...options, contentType: 'image/jpeg', multipart: false }),
        ]);
      } catch (e) {
        console.error('Envoi de photo', fichier.name, e);
        throw new Error(e instanceof Deconnecte || /401|auth/i.test(String(e?.message)) ? 'connexion au back office expirée, reconnectez-vous' : 'l’envoi a été interrompu, vérifiez votre connexion');
      }
      return { nom: base, largeur: bitmap.width, hauteur: bitmap.height, poids: fichier.size, prise, original: o.url, vue: v.url, miniature: m.url };
    } finally {
      bitmap.close?.();
    }
  }

  async function envoyer(fichiers) {
    if (!galerie || !fichiers.length) return;
    if (occupe) return toast('Un envoi est déjà en cours. Attendez qu’il soit terminé.');
    if (!jeton()) return deconnecte();
    occupe = true;
    const total = fichiers.length;
    let faits = 0;
    echecs = [];
    const file = [...fichiers];
    $('envoi').hidden = false;
    $('echecs').hidden = true;
    $('progression').max = total;
    const maj = () => {
      $('progression').value = faits + echecs.length;
      $('progression-texte').textContent = `Envoi en cours : ${faits}${NBSP}/${NBSP}${total} photos envoyées.`;
    };
    maj();
    const ouvriere = async () => {
      while (file.length) {
        const f = file.shift();
        enCours += 1;
        try {
          photos.push(await envoyerPhoto(f));
          faits += 1;
        } catch (e) {
          echecs.push({ fichier: f, raison: e?.message || 'envoi interrompu' });
        }
        enCours -= 1;
        maj();
      }
    };
    dessinerPhotos();
    await Promise.all([ouvriere(), ouvriere(), ouvriere()]);
    // Les photos arrivent dans l'ordre d'envoi des fichiers : on remet l'ordre choisi.
    photos = trierPhotos(photos, tri);
    sale = true;
    dessinerPhotos();
    if (faits && galerie && !galerie.date && !formulaire.elements.date.value) {
      // Date de la séance vide : on prend la plus ancienne date de prise de vue (elle reste modifiable).
      const dates = photos.map((p) => p.prise).filter(Boolean).sort();
      if (dates.length) { galerie.date = dates[0].slice(0, 10); formulaire.elements.date.value = galerie.date; }
    }
    if (faits) await sauverPhotos(true);
    occupe = false;
    dessinerPhotos();
    $('progression-texte').textContent = faits ? `${pluriel(faits, 'photo envoyée et enregistrée', 'photos envoyées et enregistrées')}.` : '';
    if (echecs.length) {
      $('echecs-texte').textContent = `${pluriel(echecs.length, 'photo n’a pas pu être envoyée', 'photos n’ont pas pu être envoyées')}.`;
      const ul = $('echecs-liste');
      ul.replaceChildren();
      for (const x of echecs) { const li = document.createElement('li'); li.textContent = `${x.fichier.name} : ${x.raison}`; ul.append(li); }
      $('echecs').hidden = false;
    }
  }

  const choisis = (liste) => [...liste].filter((f) => /^image\/(jpeg|png|webp|heic|heif)$/.test(f.type) || /\.(jpe?g|png|webp|heic|heif)$/i.test(f.name));
  $('f-fichiers').addEventListener('change', (e) => { envoyer(choisis(e.target.files)); e.target.value = ''; });
  $('reessayer').addEventListener('click', () => envoyer(echecs.map((x) => x.fichier)));
  const depot = $('depot');
  depot.addEventListener('dragover', (e) => { e.preventDefault(); depot.classList.add('survol'); });
  depot.addEventListener('dragleave', () => depot.classList.remove('survol'));
  depot.addEventListener('drop', (e) => { e.preventDefault(); depot.classList.remove('survol'); if (bloque()) return toast('Un envoi est déjà en cours. Attendez qu’il soit terminé.'); envoyer(choisis(e.dataTransfer.files)); });

  window.addEventListener('beforeunload', (e) => {
    if (occupe || sale) { e.preventDefault(); e.returnValue = ''; }
  });

  // ---------- Navigation ----------
  $('nouvelle').addEventListener('click', () => remplir(null));
  $('retour-liste').addEventListener('click', () => {
    if ((occupe || sale) && !confirm('Des photos ne sont pas encore enregistrées. Quitter quand même ?')) return;
    afficherListe();
  });

  afficherListe();
</script>

