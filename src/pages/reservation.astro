---
import Base from '../layouts/Base.astro';
import { seances, concours, contact, seanceVedette, deplacement, depart } from '../data';
const etapes = ['Prestation', 'Lieu & date', 'Coordonnées', 'Récapitulatif'];
---
<Base titre="Réserver une séance" description="Réservez votre séance photo équestre, votre photo de concours ou votre réel en quatre étapes." page="reservation" entete="simple">
  <a slot="entete-action" class="nl" href="/seances" style="font-size: 14px">Quitter la réservation</a>

  <section class="wrap" style="padding-top: 16px; padding-bottom: clamp(64px, 8vw, 120px)" data-reveal>
    <h1 class="d" style="font-size: clamp(52px, 7vw, 104px)">Réserver <span class="hl">votre séance</span></h1>
    <ol class="etapes" aria-label="Étapes">
      {etapes.map((e, i) => <li data-etape={i + 1} aria-current={i === 0 ? 'step' : undefined}><span class="n">{i + 1}</span><span class="t">{e}</span></li>)}
    </ol>

    <form id="resa" class="row" data-gratuit={deplacement.gratuitJusqua} data-km={deplacement.prixKm} style="gap: 40px; align-items: flex-start" novalidate>
      <div style="flex: 2 1 560px; min-width: 0">
        <fieldset class="pane" data-pane="1">
          <legend class="d" style="font-size: 44px">Quelle prestation ?</legend>
          <p class="lbl" style="color: var(--encre)">Séances équestres</p>
          <div class="choix">{seances.map((s) => <button type="button" class="option" data-formule={s.id} data-nom={s.nom} data-prix={s.prix} aria-pressed={s.id === seanceVedette?.id ? 'true' : 'false'}><strong>{s.nom}</strong><span class="d" style="font-size: 32px; color: var(--rose-profond)">{s.prix} €</span></button>)}</div>
          <p class="lbl" style="color: var(--encre)">Concours</p>
          <div class="choix">{concours.map((c) => <button type="button" class="option" data-formule={c.id} data-nom={c.nom} data-prix={c.prix} aria-pressed="false"><strong>{c.nom}</strong><span class="d" style="font-size: 32px; color: var(--rose-profond)">{c.prix} €</span></button>)}</div>
        </fieldset>

        <fieldset class="pane" data-pane="2" hidden>
          <legend class="d" style="font-size: 44px">Où et quand ?</legend>
          <label class="champ">Commune de la séance<input class="saisie" id="lieu" name="lieu" data-libelle="Lieu" type="text" placeholder="Ex. Muret" required></label>
          <p class="li" data-trajet aria-live="polite" style="margin: -8px 0 0; font-size: 14px">Choisissez votre commune dans la liste : je calcule le déplacement.</p>
          <label class="champ">Nom de l’écurie (facultatif)<input class="saisie" name="ecurie" data-libelle="Écurie" type="text"></label>
          <label class="champ" style="max-width: 320px">Date souhaitée (facultatif)<input class="saisie" name="date" data-libelle="Date souhaitée" type="date" aria-describedby="soleil" data-decrit="soleil"></label>
          <p id="soleil" class="soleil" aria-live="polite">Choisissez une date : je vous indique l’heure de la lumière dorée à Toulouse.</p>
          <div class="stack g12">
            <p style="margin: 0; font-size: 14px; font-weight: 500">Moment de la journée</p>
            <div class="choix">
              <button type="button" class="option" data-moment="Le matin" aria-pressed="false"><strong>Le matin</strong><span class="li">Lumière douce, chevaux reposés</span></button>
              <button type="button" class="option" data-moment="En fin de journée" aria-pressed="true"><strong>En fin de journée</strong><span class="li" data-note-soir>Lumière dorée</span></button>
            </div>
          </div>
        </fieldset>

        <fieldset class="pane" data-pane="3" hidden>
          <legend class="d" style="font-size: 44px">Vos coordonnées</legend>
          <div class="grille" style="--min: 240px; gap: 18px">
            <label class="champ">Prénom<input class="saisie" name="prenom" data-libelle="Prénom" type="text" autocomplete="given-name" required></label>
            <label class="champ">Nom<input class="saisie" name="nom" data-libelle="Nom" type="text" autocomplete="family-name" required></label>
            <label class="champ">E-mail<input class="saisie" name="email" data-libelle="E-mail" type="email" autocomplete="email" required></label>
            <label class="champ">Téléphone<input class="saisie" name="telephone" data-libelle="Téléphone" type="tel" autocomplete="tel"></label>
            <label class="champ">Nom de votre cheval<input class="saisie" name="cheval" data-libelle="Cheval" type="text"></label>
          </div>
          <label class="case"><input type="checkbox" name="segur" data-libelle="Cavalier des Écuries d’En Ségur (-10 %)">Je monte aux Écuries d’En Ségur (-10 %)</label>
          <label class="champ">Un mot pour Ilona (facultatif)<textarea class="saisie" name="message" data-libelle="Message" maxlength="1200"></textarea></label>
          <label class="piege" aria-hidden="true">Ne pas remplir<input name="site_web" type="text" tabindex="-1" autocomplete="off"></label>
        </fieldset>

        <fieldset class="pane" data-pane="4" hidden>
          <legend class="d" style="font-size: 44px">On vérifie ensemble</legend>
          <dl class="recap" data-recap></dl>
          <p class="texte" style="font-size: 15px">Rien n’est réglé maintenant : votre demande part directement chez Ilona, qui vous confirme la date et le prix final, déplacement compris.</p>
        </fieldset>

        <div class="pane" data-pane="5" hidden>
          <div data-ok hidden class="stack g16">
            <h2 class="d" style="font-size: clamp(52px, 7vw, 104px)">Demande <span class="hl">reçue</span></h2>
            <p class="texte">Merci ! Votre demande est bien arrivée chez Ilona. Elle vous répond par e-mail pour confirmer la date et le prix final, déplacement compris.</p>
          </div>
          <div data-secours hidden class="stack g16">
          <h2 class="d" style="font-size: clamp(52px, 7vw, 104px)">Demande <span class="hl">prête</span></h2>
          <p class="texte">Votre messagerie s’est ouverte avec la demande déjà rédigée : il ne reste qu’à l’envoyer. Ilona vous répond par e-mail pour confirmer la date.</p>
          <div class="carte stack g12" style="padding: 24px">
            <p class="lbl">Rien ne s’est ouvert ?</p>
            <p style="margin: 0; font-size: 15px; line-height: 1.6">Copiez votre demande et collez-la dans un e-mail à <a href={`mailto:${contact.email}`}>{contact.email}</a>, ou appelez le <a href={contact.telephoneLien}>{contact.telephone}</a>.</p>
            <label class="champ">Votre demande, à copier<textarea class="saisie" data-texte-demande readonly rows="8"></textarea></label>
            <button type="button" class="btn clair" data-copier style="align-self: flex-start">Copier ma demande</button>
            <p data-copie-ok role="status" style="margin: 0; font-size: 14px" hidden>Demande copiée.</p>
          </div>
          </div>
          <a class="btn contour" href="/journal/preparer-son-cheval" style="align-self: flex-start">Préparer mon cheval</a>
        </div>

        <p class="erreur" id="erreur-resa" data-erreur role="alert" hidden></p>
        <div class="navigation" data-navigation>
          <button type="button" class="btn contour" data-retour hidden>Retour</button>
          <button type="submit" class="btn" data-suivant>Continuer</button>
        </div>
      </div>

      <aside class="carte stack g12 resume" aria-label="Votre réservation">
        <p class="lbl">Votre réservation</p>
        <p style="margin: 0; font-size: 18px; font-weight: 600" data-r-nom>{seanceVedette?.nom}</p>
        <p class="prix" style="font-size: 72px; margin: 0"><span data-r-total>{seanceVedette?.prix}</span> €</p>
        <p style="margin: 0; font-size: 14px; line-height: 1.55; opacity: .9"><span data-r-remise hidden>Remise En Ségur de 10 % incluse. </span><span data-r-deplacement>Déplacement calculé selon votre commune, offert jusqu’à {deplacement.gratuitJusqua} km de {depart.ville}.</span></p>
        <div class="coups" data-coups hidden>
          <p style="margin: 0; font-size: 14px; font-weight: 500">Vos coups de cœur</p>
          <ul data-coups-liste></ul>
        </div>
        <p style="margin: 0; font-size: 14px; padding-top: 12px; border-top: 1px solid rgba(236,235,231,.18)">Une question ? {contact.telephone}</p>
      </aside>
    </form>
  </section>
</Base>

<style>
  .etapes { list-style: none; margin: 32px 0 40px; padding: 0 0 16px; display: flex; flex-wrap: wrap; gap: 8px 36px; border-bottom: 1px solid rgba(34,34,34,.2); }
  .etapes li { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 500; padding: 6px 0; }
  .etapes .n { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: inset 0 0 0 1.5px var(--encre); font-size: 13px; }
  .etapes li.faite .n { background: var(--encre); color: var(--gres); }
  .etapes li[aria-current] .n { background: var(--rose); box-shadow: none; }
  .etapes li[aria-current] .t { position: relative; z-index: 0; }
  .etapes li[aria-current] .t::before { content: ""; position: absolute; left: -3px; right: -3px; bottom: 2px; height: 9px; background: var(--rose); z-index: -1; transform-origin: 0 50%; animation: surligne .45s var(--declic) both; }
  .pane { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 22px; min-width: 0; animation: fondu .5s var(--lumiere) both; }
  .pane[hidden], .pane [hidden] { display: none; }
  .pane legend { padding: 0; margin-bottom: 22px; float: left; width: 100%; }
  .pane legend + * { clear: both; }
  .choix { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
  .recap { margin: 0; display: grid; grid-template-columns: minmax(120px, 200px) minmax(0, 1fr); font-size: 16px; }
  .recap dt, .recap dd { margin: 0; padding: 14px 0; border-top: 1px solid rgba(34,34,34,.2); }
  .recap dt { font-weight: 500; }
  .navigation { display: flex; justify-content: space-between; gap: 12px; margin-top: 40px; padding-top: 24px; border-top: 1px solid rgba(34,34,34,.2); }
  .navigation [hidden] { display: none; }
  .navigation .btn[data-suivant] { margin-left: auto; }
  .piege { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .erreur { margin: 16px 0 0; color: var(--rose-profond); font-weight: 500; }
  .recap :global(dd) { overflow-wrap: anywhere; }
  .recap :global(.modifier) { margin-left: 8px; border: 0; background: none; padding: 10px 4px; color: var(--rose-profond); text-decoration: underline; font: 500 14px 'Poppins', sans-serif; cursor: pointer; }
  .resume { flex: 1 1 300px; padding: 32px; position: sticky; top: 24px; }
  :global(.pied) { display: none; }
  .soleil { margin: -8px 0 0; padding: 12px 16px; border-radius: 12px; background: linear-gradient(135deg, rgba(232,190,60,.3), rgba(231,156,194,.3)); font-size: 15px; line-height: 1.5; max-width: 520px; }
  .coups { padding-top: 12px; border-top: 1px solid rgba(236,235,231,.18); display: flex; flex-direction: column; gap: 10px; }
  .coups ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px; flex-wrap: wrap; }
  .coups :global(img) { width: 56px; height: 70px; object-fit: cover; border-radius: 4px; box-shadow: 0 0 0 2px var(--rose); }
  @media (max-width: 760px) { .resume { position: static; order: -1; padding: 24px; } .resume .prix { font-size: 48px !important; } }
</style>

<script>
  import { ouvrirMail, lignesDuFormulaire, envoyerDemande } from '../scripts/mail.js';
  import { lumiereDuSoir, heure, jour } from '../scripts/soleil.js';
  import { brancherCommune, prixDeplacement } from '../scripts/distance.js';
  const form = document.getElementById('resa') as HTMLFormElement;
  const $ = <T extends HTMLElement>(s: string) => form.querySelector<T>(s)!;
  let etape = 1;
  let texteDemande = '';
  // Pas de date passée : « aujourd'hui » dans le fuseau du visiteur, pas en UTC.
  const aujourdhui = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; };
  $<HTMLInputElement>('[name="date"]').min = aujourdhui();
  const defilement = () => window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });

  // Préselection depuis ?formule=…
  const demande = new URLSearchParams(location.search).get('formule');
  const depart = demande && $<HTMLButtonElement>(`[data-formule="${CSS.escape(demande)}"]`);
  if (depart) { form.querySelectorAll('[data-formule]').forEach((b) => b.setAttribute('aria-pressed', 'false')); depart.setAttribute('aria-pressed', 'true'); }

  // Si aucune formule n'est présélectionnée (ex. séance mise en avant retirée), on prend la première.
  if (!form.querySelector('[data-formule][aria-pressed="true"]')) form.querySelector('[data-formule]')?.setAttribute('aria-pressed', 'true');
  const formule = () => form.querySelector<HTMLButtonElement>('[data-formule][aria-pressed="true"]');
  const moment = () => $<HTMLButtonElement>('[data-moment][aria-pressed="true"]');
  const segur = () => $<HTMLInputElement>('[name="segur"]').checked;

  // Déplacement estimé une fois la commune reconnue (null tant qu'elle ne l'est pas).
  let trajet: { nom: string; km: number; prix: number } | null = null;
  const texteDeplacementInitial = form.querySelector('[data-r-deplacement]')!.textContent ?? '';
  const texteTrajet = () => trajet ? (trajet.prix ? `${trajet.prix} € (${trajet.km} km par la route)` : `offert (${trajet.km} km par la route)`) : 'calculé par Ilona';

  function resume() {
    const f = formule();
    if (!f) return;
    const total = Number(f.dataset.prix) + (trajet?.prix ?? 0);
    $('[data-r-nom]').textContent = f.dataset.nom!;
    // Même arrondi que le calculateur de /seances : total moins la remise arrondie.
    $('[data-r-total]').textContent = String(segur() ? total - Math.round(total * 0.1) : total);
    $('[data-r-remise]').hidden = !segur();
    $('[data-r-deplacement]').textContent = trajet ? `Déplacement ${trajet.prix ? `de ${trajet.prix} € inclus` : 'offert'} (${trajet.km} km).` : texteDeplacementInitial;
  }
  if (!formule()) $<HTMLButtonElement>('[data-suivant]').disabled = true; // rien à réserver : les prestations sont vides

  brancherCommune($<HTMLInputElement>('#lieu'), (r: { nom: string; km: number | null } | null) => {
    const sortie = $('[data-trajet]');
    if (!r) { trajet = null; sortie.textContent = 'Commune non reconnue : Ilona calculera le déplacement.'; resume(); return; }
    if (r.km === null) { trajet = null; sortie.textContent = 'Distance non calculée : Ilona la calculera.'; resume(); return; }
    trajet = { ...r, prix: prixDeplacement(r.km, Number(form.dataset.gratuit), Number(form.dataset.km)) };
    sortie.textContent = `${r.nom} : ${r.km} km par la route, déplacement ${trajet.prix ? `estimé à ${trajet.prix} €` : 'offert'}.`;
    resume();
  });

  function afficher(n: number) {
    etape = n;
    form.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = Number(p.dataset.pane) !== n));
    document.querySelectorAll<HTMLElement>('[data-etape]').forEach((li) => {
      const k = Number(li.dataset.etape);
      li.classList.toggle('faite', k < n);
      if (k === n) li.setAttribute('aria-current', 'step'); else li.removeAttribute('aria-current');
      li.querySelector('.n')!.textContent = k < n ? '✓' : String(k);
    });
    $('[data-retour]').hidden = n === 1 || n === 5;
    $('[data-navigation]').hidden = n === 5;
    $('[data-suivant]').textContent = n === 4 ? 'Envoyer ma demande' : 'Continuer';
    $('[data-erreur]').hidden = true;
    if (n === 4) recap();
    // Écran 5 : le titre du bloc affiché (envoyé ou à envoyer soi-même), pas celui du bloc masqué.
    const titre = form.querySelector<HTMLElement>(`[data-pane="${n}"] legend, [data-pane="${n}"] > div:not([hidden]) h2`);
    titre?.setAttribute('tabindex', '-1');
    titre?.focus({ preventScroll: true });
    defilement();
  }

  function recap() {
    const v = (n: string) => ($<HTMLInputElement>(`[name="${n}"]`).value || '').trim();
    const date = v('date') ? v('date').split('-').reverse().join('/') : 'à convenir';
    const lignes: [string, string][] = [
      ['Prestation', `${formule().dataset.nom} · ${formule().dataset.prix} €`],
      ['Lieu', [v('lieu'), v('ecurie')].filter(Boolean).join(' · ')],
      ['Déplacement', texteTrajet()],
      ['Date', `${date} · ${moment().dataset.moment}`],
      ['Contact', `${v('prenom')} ${v('nom')} · ${v('email')}`],
      ['Remise', segur() ? 'Écuries d’En Ségur, -10 %' : 'Aucune'],
      ['Total estimé', `${$('[data-r-total]').textContent} €`],
    ];
    const dl = $('[data-recap]');
    const etapeDe: Record<string, number> = { Prestation: 1, Lieu: 2, Déplacement: 2, Date: 2, Contact: 3, Remise: 3 };
    dl.replaceChildren(...lignes.flatMap(([a, b]) => {
      const dt = document.createElement('dt'); dt.textContent = a;
      const dd = document.createElement('dd'); dd.textContent = b + ' ';
      if (etapeDe[a]) {
        const modif = document.createElement('button');
        modif.type = 'button'; modif.className = 'modifier'; modif.textContent = 'Modifier';
        modif.setAttribute('aria-label', `Modifier : ${a}`);
        modif.addEventListener('click', () => afficher(etapeDe[a]));
        dd.append(modif);
      }
      return [dt, dd];
    }));
  }

  // Même règle que le serveur (api/demande.js).
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  // Une phrase qui dit quoi faire, ou '' si le champ est bon.
  function probleme(c: HTMLInputElement): string {
    const v = c.value.trim();
    if (c.name === 'lieu' && !v) return 'Indiquez la commune de la séance.';
    if (c.name === 'prenom' && !v) return 'Indiquez votre prénom.';
    if (c.name === 'nom' && !v) return 'Indiquez votre nom.';
    if (c.name === 'email') {
      if (!v) return 'Indiquez votre adresse e-mail.';
      if (v.length > 254 || !EMAIL.test(v)) return 'Indiquez une adresse e-mail valide, par exemple nom@exemple.fr.';
    }
    if (c.name === 'date') {
      if (c.validity.badInput) return 'Cette date n’est pas valide : choisissez-la dans le calendrier.';
      if (c.value && c.value < aujourdhui()) return 'Choisissez une date à partir d’aujourd’hui.';
    }
    return '';
  }

  function valide(n: number) {
    const champs = [...form.querySelectorAll<HTMLInputElement>(`[data-pane="${n}"] input:not([type="checkbox"]):not([name="site_web"])`)];
    champs.forEach((c) => { c.removeAttribute('aria-invalid'); (c.dataset.decrit ? c.setAttribute('aria-describedby', c.dataset.decrit) : c.removeAttribute('aria-describedby')); });
    for (const c of champs) {
      const message = probleme(c);
      if (!message) continue;
      const err = $('[data-erreur]');
      err.textContent = message;
      err.hidden = false;
      c.setAttribute('aria-invalid', 'true');
      c.setAttribute('aria-describedby', 'erreur-resa');
      c.focus();
      return false;
    }
    $('[data-erreur]').hidden = true;
    return true;
  }
  // Une saisie corrigée retire son signalement.
  form.addEventListener('input', (e) => {
    const c = e.target as HTMLElement;
    if (c.getAttribute('aria-invalid')) { c.removeAttribute('aria-invalid'); (c.dataset.decrit ? c.setAttribute('aria-describedby', c.dataset.decrit) : c.removeAttribute('aria-describedby')); $('[data-erreur]').hidden = true; }
  });

  form.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-formule], [data-moment]');
    if (!b) return;
    const groupe = b.hasAttribute('data-formule') ? '[data-formule]' : '[data-moment]';
    form.querySelectorAll(groupe).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    resume();
  });
  $('[name="segur"]').addEventListener('change', resume);

  // Heure dorée pour la date choisie.
  $<HTMLInputElement>('[name="date"]').addEventListener('change', (e) => {
    const v = (e.target as HTMLInputElement).value;
    const sortie = document.getElementById('soleil')!;
    if (!v) { sortie.textContent = 'Choisissez une date : je vous indique l’heure de la lumière dorée à Toulouse.'; return; }
    const d = new Date(`${v}T12:00:00`);
    const { doree, coucher } = lumiereDuSoir(d);
    sortie.textContent = `Le ${jour(d)}, lumière dorée de ${heure(doree)} à ${heure(coucher)} (coucher du soleil).`;
    $('[data-note-soir]').textContent = `Lumière dorée dès ${heure(doree)}`;
  });

  // Coups de cœur choisis sur l'accueil.
  let coups: { alt: string; src: string }[] = [];
  try { coups = JSON.parse(localStorage.getItem('ilona-coups-de-coeur') || '[]'); } catch { coups = []; }
  if (!Array.isArray(coups)) coups = [];
  if (coups.length) {
    const bloc = $('[data-coups]');
    const liste = $('[data-coups-liste]');
    bloc.hidden = false;
    liste.replaceChildren(...coups.map((c) => {
      const li = document.createElement('li'); const img = document.createElement('img');
      // Photo changée ou retirée depuis la visite : la vignette cassée disparaît.
      img.addEventListener('error', () => { li.remove(); coups = coups.filter((x) => x !== c); if (!liste.children.length) bloc.hidden = true; });
      img.src = c.src; img.alt = c.alt; li.append(img); return li;
    }));
  }
  $('[data-retour]').addEventListener('click', () => afficher(etape - 1));
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!valide(etape)) return;
    if (etape < 4) return afficher(etape + 1);
    const lignes = [`Prestation : ${formule().dataset.nom} (${formule().dataset.prix} €)`, `Déplacement : ${texteTrajet()}`, `Total estimé : ${$('[data-r-total]').textContent} €`, `Moment : ${moment().dataset.moment}`, ...lignesDuFormulaire(form),
      coups.length ? `Coups de cœur sur le site : ${coups.map((c) => c.alt).join(' ; ')}` : '',
      new URLSearchParams(location.search).get('source') === 'quiz' ? 'Formule conseillée par le quiz du site' : ''];
    texteDemande = lignes.filter(Boolean).join('\n');
    $<HTMLTextAreaElement>('[data-texte-demande]').value = texteDemande;
    const bouton = $<HTMLButtonElement>('[data-suivant]');
    bouton.disabled = true; bouton.textContent = 'Envoi en cours…';
    const v = (n: string) => ($<HTMLInputElement>(`[name="${n}"]`).value || '').trim();
    const ok = await envoyerDemande({ type: 'reservation', nom: `${v('prenom')} ${v('nom')}`.trim(), email: v('email'), lignes: lignes.filter(Boolean), site_web: v('site_web') });
    bouton.disabled = false;
    if (!ok) ouvrirMail(form.closest('main')!.querySelector<HTMLAnchorElement>('a[href^="mailto:"]')!.href.replace('mailto:', ''), `Réservation · ${formule().dataset.nom}`, lignes);
    $('[data-ok]').hidden = !ok;
    $('[data-secours]').hidden = ok;
    afficher(5);
  });
  $('[data-copier]').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(texteDemande); $('[data-copie-ok]').textContent = 'Demande copiée.'; $('[data-copie-ok]').hidden = false; } catch { $('[data-copie-ok]').textContent = 'Copie impossible : sélectionnez le texte de la demande ci-dessus.'; $('[data-copie-ok]').hidden = false; }
  });
  $<HTMLTextAreaElement>('[data-texte-demande]').addEventListener('focus', (e) => (e.target as HTMLTextAreaElement).select());
  resume();
</script>
