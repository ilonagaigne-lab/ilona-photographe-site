---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { contact } from '../../data';
import { photo, cadrage, lignes, paragraphe } from '../../lib/contenu';
import t from '../../contenu/pages/academie-lumiere.json';

const lecons = t.sommaire.lecons;
// Une ligne vide dans le texte = un nouveau paragraphe.
const paragraphes = (texte = '') => texte.split(/\r?\n\s*\r?\n/).filter((x) => x.trim());
const { titre, description } = t.referencement;
---
<Base titre={`${titre} · Académie`} description={description} page="academie" type="article" fil={[{ nom: 'Académie', href: '/academie/lire-la-lumiere-du-soir' }, { nom: titre, href: '/academie/lire-la-lumiere-du-soir' }]} schema={[{ '@type': ['Article', 'LearningResource'], headline: titre, description, author: { '@id': 'https://ilonagaigne.com/#ilona' }, publisher: { '@id': 'https://ilonagaigne.com/#activite' }, inLanguage: 'fr-FR', learningResourceType: 'Leçon', educationalLevel: 'Débutant', timeRequired: 'PT6M' }]}>
  <div class="wrap section row" style="padding-top: clamp(16px, 3vw, 40px); gap: 48px clamp(40px, 6vw, 96px); align-items: flex-start">
    <aside class="sommaire" aria-label="Leçons du module">
      <p class="lbl">{t.sommaire.surtitre}</p>
      <ol>
        {lecons.map((l, i) => (
          <li aria-current={i === 2 ? 'page' : undefined}><span class="d">{String(i + 1).padStart(2, '0')}</span><span class="t">{l}</span>{i !== 2 && <span class="bientot">bientôt</span>}</li>
        ))}
      </ol>
    </aside>

    <article style="flex: 3 1 560px; min-width: 0; max-width: 820px" data-reveal>
      <p class="lbl">{t.entete.surtitre}</p>
      <h1 class="d" style="font-size: clamp(56px, 8vw, 128px); margin-top: 18px" set:html={lignes(t.entete.titre)} />
      <p class="apparait" style="margin: 28px 0 0; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.6" set:html={paragraphe(t.entete.chapo)} />

      <Photo src={photo(t.photo.image)} alt={t.photo.alt ?? ''} ratio="16 / 9" pos={cadrage(t.photo, '50% 35%')} prioritaire tailles="(max-width: 760px) 100vw, 820px" style="margin-top: 48px; border-radius: 16px" />

      <div class="prose">
        {t.sections.map((x) => (
          <>
            <h2>{x.titre}</h2>
            {paragraphes(x.texte).map((p) => <p set:html={paragraphe(p)} />)}
          </>
        ))}
      </div>

      <section class="carte stack g16 exercice" aria-labelledby="exercice">
        <p class="lbl">{t.exercice.surtitre}</p>
        <h2 id="exercice" class="d" style="font-size: clamp(32px, 3.4vw, 44px)">{t.exercice.titre}</h2>
        <div>
          {t.exercice.etapes.map((e) => <label class="case"><input type="checkbox">{e}</label>)}
        </div>
        <p class="li" style="margin: 0; font-size: 15px">{t.exercice.partage} <a href={contact.instagramLien}>{contact.instagram}</a>.</p>
      </section>

      <nav class="row entre g16" style="margin-top: 56px" aria-label="Suite">
        <a class="btn contour" href="/journal/preparer-son-cheval">Lire aussi : préparer son cheval</a>
        <a class="btn" href="/reservation">Réserver une séance</a>
      </nav>
    </article>
  </div>
</Base>

<style>
  .sommaire { flex: 1 1 260px; max-width: 320px; position: sticky; top: 24px; display: flex; flex-direction: column; gap: 16px; }
  .sommaire ol { list-style: none; margin: 0; padding: 0; }
  .sommaire li { display: flex; gap: 12px; align-items: baseline; padding: 12px 0; border-top: 1px solid rgba(34,34,34,.15); font-size: 15px; }
  .sommaire li:last-child { border-bottom: 1px solid rgba(34,34,34,.15); }
  .sommaire .d { font-size: 20px; color: var(--rose-profond); }
  .sommaire li[aria-current] { font-weight: 600; }
  .sommaire li[aria-current] .t { position: relative; z-index: 0; }
  .sommaire li[aria-current] .t::before { content: ""; position: absolute; left: -3px; right: -3px; bottom: 2px; height: 8px; background: var(--rose); z-index: -1; }
  .bientot { margin-left: auto; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; opacity: .7; }
  .prose h2 { font-family: 'Anton', Impact, sans-serif; font-weight: 400; text-transform: uppercase; font-size: clamp(32px, 3.4vw, 40px); line-height: 1; margin: 56px 0 18px; }
  .prose p { margin: 0 0 18px; font-size: clamp(16px, 1.3vw, 18px); line-height: 1.75; }
  .exercice { margin-top: 56px; padding: clamp(24px, 3vw, 40px); }
  .exercice .case { border-top: 1px solid rgba(236,235,231,.18); padding: 10px 0; }
  .exercice .case input { accent-color: var(--rose); }
  .exercice a { color: var(--rose); }
  @media (max-width: 900px) { .sommaire { position: static; max-width: none; order: 2; } }
</style>
