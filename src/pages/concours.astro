---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Reel from '../components/Reel.astro';
import { agenda, contact, concours, listeConcours } from '../data';
import { photo, cadrage, surligne, lignes, paragraphe } from '../lib/contenu';
import t from '../contenu/pages/concours.json';

// Formule du réel souvenir (bouton de la section vidéo) : sinon la première formule avec vidéo.
const reel = concours.find((c) => c.id === 'concours-reel') ?? concours.find((c) => c.video);
---
<Base titre="Photographe de concours équestre" description={`Photographe de concours équestre près de Toulouse : ${listeConcours}. Réservez avant l’épreuve.`} page="concours">

  <section class="wrap row bas" style="padding-top: clamp(24px, 4vw, 64px); gap: 40px clamp(40px, 6vw, 96px)" data-reveal aria-labelledby="titre">
    <div style="flex: 2 1 560px">
      <p class="lbl">{t.entete.surtitre}</p>
      <h1 id="titre" class="d" style="font-size: clamp(72px, 12vw, 200px); margin-top: 18px" set:html={lignes(t.entete.titre)} />
      <p class="chapo apparait" style="margin-top: 32px" set:html={paragraphe(t.entete.chapo)} />
    </div>
    <Photo src={photo(t.entete.photo.image)} alt={t.entete.photo.alt ?? ''} ratio="4 / 5" pos={cadrage(t.entete.photo, '52% 50%')} prioritaire delai=".3s" tailles="(max-width: 760px) 100vw, 33vw" style="flex: 1 1 320px" />
  </section>

  <section class="wrap section stack g48" data-reveal aria-labelledby="formats">
    <h2 id="formats" class="d h2" set:html={surligne(t.formats.titre)} />
    <div class="grille">
      {concours.map((c) => (
        <article class="carte stack g16" style={`padding: 36px${c.vedette ? '; box-shadow: 0 0 0 3px var(--or), var(--ombre)' : ''}`}>
          {c.photo && c.video ? <div class="row g8"><span class="chip">Photo</span><span class="chip or">Vidéo</span></div>
            : c.video ? <span class="chip or" style="align-self: flex-start">Vidéo</span>
            : <span class="chip" style="align-self: flex-start">Photo</span>}
          <h3 class="d h3">{c.nomCourt}</h3>
          <p class="prix" style="font-size: 88px; margin: 0">{c.prix} €</p>
          <p style="margin: 0; font-size: 15px; line-height: 1.6; opacity: .9; flex: 1">{c.description}</p>
          <a class="btn clair" href={`/reservation?formule=${c.id}`} style="align-self: flex-start">Choisir {c.nomCourt}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section sans-haut row centre" style="gap: 40px clamp(40px, 6vw, 96px)" data-reveal aria-labelledby="reel">
    <div class="stack g20" style="flex: 1 1 420px">
      <span class="chip or" style="align-self: flex-start">{t.reel.etiquette}</span>
      <h2 id="reel" class="d h2" set:html={surligne(t.reel.titre)} />
      <p class="texte" style="max-width: 520px" set:html={paragraphe(t.reel.texte)} />
      <a class="btn contour" href={reel ? `/reservation?formule=${reel.id}` : '/reservation'} style="align-self: flex-start">Réserver mon réel{reel && ` · ${reel.prix} €`}</a>
    </div>
    <Reel video={t.reel.video} or style="flex: 0 1 380px" />
  </section>

  <section class="wrap section sans-haut stack g32" data-reveal aria-labelledby="agenda">
    <div class="row entre bas g20">
      <h2 id="agenda" class="d h2" set:html={surligne(t.agenda.titre)} />
      <p class="texte" style="max-width: 380px; font-size: 15px" set:html={paragraphe(t.agenda.texte)} />
    </div>
    {agenda.length > 0 ? (
      <ul class="agenda">
        {agenda.map((a) => (
          <li><p class="d" style="font-size: 40px">{a.date}</p><p style="font-weight: 600; font-size: 17px">{a.nom}</p><p class="li">{[a.lieu, a.discipline].filter(Boolean).join(" · ")}</p><a class="btn contour" href="/reservation?formule=concours-photo">Réserver ma photo</a></li>
        ))}
      </ul>
    ) : (
      <div class="carte stack g16" style="padding: clamp(24px, 3vw, 40px); max-width: 760px">
        <p class="lbl">Agenda</p>
        <p style="margin: 0; font-size: 18px; line-height: 1.6" set:html={paragraphe(t.agenda.vide)} />
        <div class="row g12"><a class="btn clair" href={`mailto:${contact.email}?subject=${encodeURIComponent('Photo de concours')}`}>Écrire à Ilona</a><a class="btn clair" href={contact.instagramLien} style="background: var(--pervenche)">Voir Instagram</a></div>
      </div>
    )}
  </section>

  <section class="sombre" data-reveal aria-labelledby="cta">
    <div class="wrap row entre centre g32" style="padding-block: clamp(64px, 8vw, 96px)">
      <h2 id="cta" class="d" style="font-size: clamp(52px, 8vw, 120px)" set:html={surligne(t.fin.titre, { plein: true })} />
      <a class="btn clair grand" href="/reservation?formule=concours-photo">Réserver mon concours</a>
    </div>
  </section>
</Base>

<style>
  .agenda { list-style: none; margin: 0; padding: 0; }
  .agenda li { display: grid; grid-template-columns: 160px minmax(0, 1fr) minmax(0, 1fr) auto; gap: 8px 24px; align-items: center; padding: 22px 0; border-top: 1px solid rgba(34,34,34,.2); }
  .agenda li:last-child { border-bottom: 1px solid rgba(34,34,34,.2); }
  .agenda p { margin: 0; }
  @media (max-width: 760px) {
    .agenda li { grid-template-columns: 1fr; }
    .agenda .btn { justify-self: start; }
  }
</style>
