---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Prix from '../components/Prix.astro';
import Reel from '../components/Reel.astro';
import Coeur from '../components/Coeur.astro';
import Instagram from '../components/Instagram.astro';
import contenuContact from '../contenu/contact.json';
import { Image } from 'astro:assets';
import { contact, seances, concours, temoignages, prixMinSeance, prixMinConcours } from '../data';
import { photo, cadrage, surligne, lignes, paragraphe } from '../lib/contenu';
import t from '../contenu/pages/index.json';

// {prix-seance} / {prix-concours} dans un texte = prix le plus bas, tiré des formules.
const prix = (texte = '') => texte.replaceAll('{prix-seance}', `${prixMinSeance} €`).replaceAll('{prix-concours}', `${prixMinConcours} €`);
// Cadrages d'origine des images (utilisés tant qu'aucun cadrage n'est choisi dans le back office).
const posPortes = ['50% 30%', '52% 50%', '50% 35%'];
const posUnivers = ['50% 30%', '52% 50%', '45% 40%', '50% 50%', '50% 50%'];
const posFavoris = ['50% 30%', '50% 62%', '50% 40%', '40% 40%'];
const posArticles = ['50% 40%', '50% 55%'];
const favorisDefaut = false;
// Identifiant d'une photo favorite : le nom du fichier (sert à retrouver les coups de cœur d'une visite à l'autre).
const favoris = t.favoris.photos.map((f, i) => ({ id: f.image.split('/').pop()!.replace(/\.[^.]+$/, ''), src: photo(f.image), alt: f.alt ?? '', pos: cadrage(f, posFavoris[i]), on: favorisDefaut }));
const univers = t.univers.liste.map((u, i) => ({ titre: u.titre, chip: u.etiquette, classe: u.couleur, href: u.lien, src: photo(u.photo.image), alt: u.photo.alt ?? '', pos: cadrage(u.photo, posUnivers[i]) }));
---
<Base titre="Ilona Photographe · photographe équestre à Toulouse" description="Photographe et vidéaste équestre près de Toulouse : séances avec votre cheval, photos de concours, contenus pour les marques équestres." page="accueil">

  <section class="wrap" style="padding-top: clamp(24px, 4vw, 64px)" data-reveal aria-labelledby="titre">
    <p class="lbl">{t.entete.surtitre}</p>
    <h1 id="titre" style="margin: 20px 0 0">
      <span class="sr">Surligner l’instant.</span>
      <span class="pochoir" aria-hidden="true">
        <span class="pochoir-trait"></span>
        <video autoplay muted loop playsinline preload="auto" poster={t.entete.videoTitre.affiche || undefined} tabindex="-1">
          <source src={t.entete.videoTitre.fichierMobile} type="video/mp4" media="(max-width: 760px)">
          <source src={t.entete.videoTitre.fichier} type="video/mp4">
        </video>
      </span>
    </h1>
    <div class="row entre bas g32" style="margin-top: 44px">
      <p class="chapo apparait" style="--d: .6s" set:html={paragraphe(t.entete.chapo)} />
      <div class="row g12 apparait" style="--d: .75s">
        <a class="btn" href="/reservation">Réserver une séance
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        <a class="btn contour" href="/trouver-ma-seance">Trouver ma séance en 30 s</a>
      </div>
    </div>
    <ul class="reperes apparait" style="--d: .9s" aria-label="En bref">
      {t.entete.reperes.map((r) => <li><strong>{prix(r.fort)}</strong> {prix(r.texte)}</li>)}
    </ul>
  </section>

  <div data-reveal style="margin-top: clamp(40px, 6vw, 88px)">
    <Photo src={photo(t.grandePhoto.photo.image)} alt={t.grandePhoto.photo.alt ?? ''} ratio="2.05 / 1" pos={cadrage(t.grandePhoto.photo, '56% 50%')} prioritaire delai=".4s" tailles="100vw" style="max-height: 820px">
      <figcaption class="chip" style="position: absolute; left: var(--marge); bottom: 24px; background: rgba(34,34,34,.78); color: var(--gres); text-transform: none; letter-spacing: 0; font-size: 13px; height: 36px; padding: 0 16px">{t.grandePhoto.legende}</figcaption>
    </Photo>
  </div>

  <section class="wrap section stack g32" data-reveal aria-labelledby="portes">
    <h2 id="portes" class="d h2" set:html={surligne(t.portes.titre)} />
    <div class="grille portes" style="--min: 280px">
      {t.portes.cartes.map((p, i) => (
        <a class="porte" href={p.lien}>
          <Photo src={photo(p.photo.image)} alt={p.photo.alt ?? ''} pos={cadrage(p.photo, posPortes[i] ?? '50% 50%')} ratio="4 / 3" curseur={false} tailles="(max-width: 760px) 100vw, 33vw" />
          <span class="porte-texte"><span class="d" style="font-size: clamp(30px, 3vw, 40px)">{p.titre}</span><span>{prix(p.texte)}</span><span class="porte-fleche">{p.fleche}</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section sans-haut row centre" style="gap: clamp(40px, 6vw, 104px)" data-reveal aria-labelledby="moi">
    <Photo src={photo(t.moi.photo.image)} alt={t.moi.photo.alt ?? ''} ratio="3 / 4" pos={cadrage(t.moi.photo, '50% 50%')} style="flex: 1 1 320px; max-width: 500px" />
    <div class="stack g24" style="flex: 1 1 440px">
      <p class="lbl">{t.moi.surtitre}</p>
      <h2 id="moi" class="d h2" set:html={lignes(t.moi.titre, 0.1)} />
      <p class="texte" style="max-width: 560px" set:html={paragraphe(t.moi.texte)} />
      <ul class="liste li">{t.moi.liste.map((l) => <li>{l}</li>)}</ul>
      <a class="btn contour" href="/seances" style="align-self: flex-start">Mon approche</a>
    </div>
  </section>

  <section class="wrap section sans-haut stack g48" data-reveal aria-labelledby="offres">
    <div class="row entre bas g20">
      <h2 id="offres" class="d h2" set:html={surligne(t.offres.titre)} />
      <p class="lbl">{t.offres.mention}</p>
    </div>
    <div class="grille">
      <article class="carte stack g20" style="padding: 36px">
        <span class="chip" style="align-self: flex-start">Photo</span>
        <h3 class="d h3">{t.offres.seances}</h3>
        <p style="margin: 0; display: flex; align-items: baseline; gap: 10px"><span style="font-size: 14px">dès</span><span class="prix" style="font-size: 80px"><Prix valeur={prixMinSeance} /></span></p>
        <ul class="tarifs" style="flex: 1">{seances.map((s) => <li>{s.nom}<span class="prix">{s.prix} €</span></li>)}</ul>
        <a class="btn clair" href="/seances" style="align-self: flex-start">Voir les séances</a>
      </article>
      <article class="carte stack g20" style="padding: 36px">
        <div class="row g8"><span class="chip">Photo</span><span class="chip or">Vidéo</span></div>
        <h3 class="d h3">{t.offres.concours}</h3>
        <p style="margin: 0; display: flex; align-items: baseline; gap: 10px"><span style="font-size: 14px">dès</span><span class="prix" style="font-size: 80px"><Prix valeur={prixMinConcours} /></span></p>
        <ul class="tarifs" style="flex: 1">{concours.map((c) => <li>{c.nomCourt}<span class="prix">{c.prix} €</span></li>)}</ul>
        <a class="btn clair" href="/concours" style="align-self: flex-start">Voir l’agenda</a>
      </article>
      <article class="carte stack g20" style="padding: 36px">
        <span class="chip pervenche" style="align-self: flex-start">Réseaux</span>
        <h3 class="d h3">{t.offres.marques.titre}</h3>
        <p class="prix" style="font-size: clamp(56px, 15vw, 80px); margin: 0; white-space: nowrap">{t.offres.marques.prix}</p>
        <ul class="tarifs" style="flex: 1">{t.offres.marques.liste.map((l) => <li>{l}</li>)}</ul>
        <a class="btn clair" href="/marques" style="align-self: flex-start">Parler de votre projet</a>
      </article>
    </div>
  </section>

  <section class="sombre" data-reveal aria-labelledby="quiz-titre">
    <div class="wrap row entre centre g32" style="padding-block: clamp(56px, 7vw, 96px)">
      <div class="stack g16" style="flex: 1 1 520px">
        <p class="lbl">{t.quiz.surtitre}</p>
        <h2 id="quiz-titre" class="d" style="font-size: clamp(44px, 6vw, 88px); line-height: 1" set:html={surligne(t.quiz.titre, { plein: true })} />
        <p style="margin: 0; font-size: 17px; line-height: 1.6; max-width: 560px; opacity: .9" set:html={paragraphe(t.quiz.texte)} />
      </div>
      <a class="btn clair grand" href="/trouver-ma-seance">Commencer le quiz →</a>
    </div>
  </section>

  <section class="wrap section stack g48" data-reveal aria-labelledby="univers">
    <div class="row entre bas g20">
      <h2 id="univers" class="d h2" set:html={surligne(t.univers.titre)} />
      <p class="texte" style="max-width: 380px; font-size: 16px" set:html={paragraphe(t.univers.texte)} />
    </div>
    <div class="grille univers" style="--min: 320px; row-gap: 40px">
      {univers.slice(0, 4).map((u) => (
        <a class="univers-it stack g12" href={u.href}>
          <Photo src={u.src} alt={u.alt} pos={u.pos} tailles="(max-width: 760px) 100vw, 33vw" />
          <span class="row entre centre g12"><span class="d" style="font-size: 36px">{u.titre}</span><span class:list={['chip', u.classe]}>{u.chip}</span></span>
        </a>
      ))}
      <div class="univers-it stack g12">
        <Reel video={t.univers.video.video} style="aspect-ratio: 4 / 5; border-radius: 4px; box-shadow: none" />
        <span class="row entre centre g12"><span class="d" style="font-size: 36px">{t.univers.video.titre}</span><span class="chip or">{t.univers.video.etiquette}</span></span>
      </div>
      {univers.slice(4).map((u) => (
        <a class="univers-it stack g12" href={u.href}>
          <Photo src={u.src} alt={u.alt} pos={u.pos} tailles="(max-width: 760px) 100vw, 33vw" />
          <span class="row entre centre g12"><span class="d" style="font-size: 36px">{u.titre}</span><span class:list={['chip', u.classe]}>{u.chip}</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section sans-haut row centre" style="gap: clamp(40px, 6vw, 96px)" data-reveal aria-labelledby="favoris">
    <div class="stack g24" style="flex: 1 1 380px">
      <p class="lbl">{t.favoris.surtitre}</p>
      <h2 id="favoris" class="d h2" set:html={surligne(t.favoris.titre)} />
      <p class="texte" style="max-width: 480px" set:html={paragraphe(t.favoris.texte)} />
      <p style="margin: 0; display: flex; align-items: baseline; gap: 14px" aria-live="polite"><span class="d" style="font-size: 72px" data-compte>0</span><span data-libelle>coup de cœur</span></p>
      <div class="row g12"><a class="btn" href="/reservation">Réserver avec mes coups de cœur</a><a class="btn contour" href="/galerie">Voir une galerie client</a></div>
    </div>
    <ul class="mini-galerie" style="flex: 1 1 520px">
      {favoris.map((f) => (
        <li class:list={['tuile', { choisie: f.on }]} data-curseur="choisir" data-id={f.id} data-alt={f.alt}>
          <Image src={f.src} alt={f.alt} widths={[400, 700]} sizes="(max-width: 760px) 50vw, 25vw" style={`object-position: ${f.pos}`} />
          <span class="flash" aria-hidden="true"></span><span class="cadre" aria-hidden="true"></span>
          <Coeur choisie={f.on} nom={f.alt} />
        </li>
      ))}
    </ul>
  </section>

  {temoignages.length > 0 && (
    <section class="wrap section sans-haut stack g32" data-reveal aria-labelledby="avis">
      <h2 id="avis" class="d h2" set:html={surligne(t.avis.titre)} />
      <div class="grille" style="--min: 300px">
        {temoignages.map((a) => (
          <figure class="carte stack g16" style="margin: 0; padding: 32px">
            <blockquote style="margin: 0; font-size: 18px; line-height: 1.6">« {a.texte} »</blockquote>
            <figcaption style="font-size: 14px"><strong>{a.auteur}</strong>{a.cheval && ` & ${a.cheval}`}{a.seance && ` · ${a.seance}`}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <Instagram textes={t.instagram} flux={contenuContact.fluxInstagram ?? ''} />

  <section class="sombre" data-reveal aria-labelledby="segur">
    <div class="wrap row entre centre g48" style="padding-block: clamp(64px, 8vw, 120px)">
      <div class="stack g12">
        <p class="lbl">{t.segur.surtitre}</p>
        <h2 id="segur" class="d" style="font-size: clamp(40px, 5vw, 72px)">{t.segur.titre}</h2>
        <p style="margin: 0; font-size: 15px; opacity: .85" set:html={paragraphe(t.segur.texte)} />
      </div>
      <p class="d" style="font-size: clamp(46px, 7vw, 104px); line-height: 1.06; text-align: right; color: var(--encre)" set:html={surligne(t.segur.remise, { plein: true, delai: '.3s' })} />
    </div>
  </section>

  <section class="wrap section stack g48" data-reveal aria-labelledby="apprendre">
    <div class="row entre bas g20">
      <h2 id="apprendre" class="d h2" set:html={surligne(t.apprendre.titre)} />
      <p class="lbl">{t.apprendre.mention}</p>
    </div>
    <div class="grille" style="row-gap: 40px">
      {t.apprendre.articles.map((a, i) => (
        <a class="article-carte stack g16" href={a.lien}>
          <Photo src={photo(a.photo.image)} alt={a.photo.alt ?? ''} ratio="16 / 10" pos={cadrage(a.photo, posArticles[i] ?? '50% 50%')} cache="#EAE2D4" tailles="(max-width: 760px) 100vw, 50vw" />
          <span class="chip contour" style="align-self: flex-start">{a.etiquette}</span>
          <span class="d h3">{a.titre}</span>
          <span class="texte" style="font-size: 16px">{a.texte}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section sans-haut stack g32" data-reveal aria-labelledby="fin">
    <h2 id="fin" class="d deborde" style="font-size: clamp(64px, 14vw, 210px); line-height: 1.02" set:html={surligne(t.fin.titre)} />
    <div class="row entre bas g32">
      <div class="stack g8" style="font-size: 17px">
        <a href={contact.telephoneLien} style="color: var(--encre); text-decoration: none; font-weight: 500; padding: 6px 0">{contact.telephone}</a>
        <a href={`mailto:${contact.email}`} style="color: var(--encre); padding: 6px 0">{contact.email}</a>
        <a href={contact.instagramLien} style="color: var(--encre); padding: 6px 0">{contact.instagram}</a>
        <p class="li" style="margin: 8px 0 0; font-size: 15px">{t.fin.mention}</p>
      </div>
      <a class="btn grand" href="/reservation">Réserver une séance
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
    </div>
  </section>
</Base>

<style>
  .univers-it, .article-carte { color: var(--encre); text-decoration: none; }
  .univers-it :global(.ph img) { transition: transform .7s var(--lumiere); }
  .univers-it:hover :global(.ph img) { transform: scale(1.05); }
  .reperes { list-style: none; margin: 32px 0 0; padding: 18px 0 0; border-top: 1px solid rgba(34,34,34,.2); display: flex; flex-wrap: wrap; gap: 10px 36px; font-size: 15px; }
  .reperes strong { font-weight: 600; color: var(--rose-profond); }
  .porte { display: flex; flex-direction: column; color: var(--encre); text-decoration: none; border-radius: 16px; overflow: hidden; box-shadow: inset 0 0 0 1.5px rgba(34,34,34,.2); transition: box-shadow .3s var(--lumiere); }
  .porte:hover, .porte:focus-visible { box-shadow: inset 0 0 0 3px var(--encre); }
  .porte-texte { display: flex; flex-direction: column; gap: 10px; padding: 22px 24px 26px; font-size: 15px; line-height: 1.55; flex: 1; }
  .porte-fleche { margin-top: auto; font-weight: 600; color: var(--rose-profond); }
  .porte :global(.ph img) { transition: transform .7s var(--lumiere); }
  .porte:hover :global(.ph img) { transform: scale(1.04); }
  .mini-galerie { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 760px) {
    .grille.univers { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--marge); margin-inline: calc(-1 * var(--marge)); padding-inline: var(--marge); padding-bottom: 8px; }
    .grille.univers > * { flex: none; width: 72vw; scroll-snap-align: start; }
    .mini-galerie { gap: 8px; }
  }
</style>

<script>
  // Favoris de la mini-galerie : flash, cadre rose, compteur.
  const zone = document.querySelector('.mini-galerie');
  const compte = document.querySelector('[data-compte]');
  const libelle = document.querySelector('[data-libelle]');
  const CLE = 'ilona-coups-de-coeur';
  const lire = (): { id: string; alt: string; src: string }[] => { try { return JSON.parse(localStorage.getItem(CLE) || '[]'); } catch { return []; } };
  const ecrire = (v: unknown) => { try { localStorage.setItem(CLE, JSON.stringify(v)); } catch { /* stockage indisponible : on continue sans */ } };
  function compter() {
    const n = zone!.querySelectorAll('.coeur[aria-pressed="true"]').length;
    compte!.textContent = String(n);
    libelle!.textContent = n > 1 ? 'coups de cœur' : 'coup de cœur';
  }
  // Restaure les coups de cœur déjà choisis lors d'une visite précédente.
  const deja = new Set(lire().map((c) => c.id));
  zone?.querySelectorAll<HTMLElement>('.tuile').forEach((t) => {
    if (!deja.has(t.dataset.id!)) return;
    t.classList.add('choisie'); t.querySelector('.coeur')!.setAttribute('aria-pressed', 'true');
  });
  if (zone) compter();
  zone?.addEventListener('click', (e) => {
    const bouton = (e.target as HTMLElement).closest('.coeur');
    if (!bouton) return;
    const tuile = bouton.closest('.tuile')!;
    const on = bouton.getAttribute('aria-pressed') !== 'true';
    bouton.setAttribute('aria-pressed', String(on));
    tuile.classList.toggle('choisie', on);
    if (on) { tuile.classList.remove('flashe'); void (tuile as HTMLElement).offsetWidth; tuile.classList.add('flashe'); }
    compter();
    ecrire([...zone.querySelectorAll<HTMLElement>('.tuile.choisie')].map((t) => ({ id: t.dataset.id, alt: t.dataset.alt, src: t.querySelector('img')!.currentSrc || t.querySelector('img')!.src })));
  });
</script>
